---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

<nav class="nav" id="nav">
  <div class="nav__bar container">

    <!-- ── Logo ── -->
    <a href={base} class="nav__logo" aria-label="Recomp360 home">
      <img src={`${base}images/logo%20recomp360.png`} alt="Recomp360" />
    </a>

    <!-- ── Desktop links ── -->
    <ul class="nav__links" id="nav-links">

      <!-- Logo mobile (visibile solo nell'overlay) -->
      <li class="nav__mobile-logo" aria-hidden="true">
        <img src={`${base}images/logo%20recomp360.png`} alt="" />
      </li>

      <!-- Chi Siamo — link semplice -->
      <li class="nav__item">
        <a
          href={`${base}about`}
          class:list={['nav__link', { 'is-active': pathname.includes('/about') }]}
        >Chi Siamo</a>
      </li>

      <!-- Il Metodo — link semplice -->
      <li class="nav__item">
        <a
          href={`${base}metodo`}
          class:list={['nav__link', { 'is-active': pathname.includes('/metodo') }]}
        >Il Metodo</a>
      </li>

      <!-- Corsi — link semplice -->
      <li class="nav__item">
        <a
          href={`${base}corsi`}
          class:list={['nav__link', { 'is-active': pathname.includes('/corsi') }]}
        >Corsi</a>
      </li>


    </ul>

    <!-- ── Destra: CTA + burger ── -->
    <div class="nav__right">
      <button class="btn-outline nav__cta contact-trigger">Contattaci</button>
      <button class="btn-primary nav__cta gp-trigger">
        Inizia Ora
      </button>
      <button class="nav__burger" id="nav-burger" aria-label="Apri menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</nav>

<!-- ── Pulsanti fissi in fondo al menu mobile ── -->
<div class="nav__mobile-actions" id="nav-mobile-actions" aria-hidden="true">
  <button class="btn-primary nav__mob-btn gp-trigger">
    Inizia Ora
  </button>
  <button class="btn-outline nav__mob-btn contact-trigger">
    Contattaci
  </button>
</div>

<style>
/* ── SHELL ─────────────────────────────────────────────────────────────────── */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  border-bottom: 1px solid transparent;
  transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
}
.nav.scrolled {
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
}

/* ── BAR: grid 3 colonne → logo | links | right ───────────────────────────── */
.nav__bar {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  height: 72px;
}

.nav__logo {
  display: flex;
  align-items: center;
  overflow: visible;
}

.nav__logo img {
  height: 64px;
  width: auto;
  display: block;
}

.nav__right {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 16px;
}
.nav__cta { font-size: 18px; }

/* ── LINKS ─────────────────────────────────────────────────────────────────── */
.nav__links {
  display: flex;
  align-items: center;
  gap: 0;
}

.nav__link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text);
  padding: 8px 14px;
  background: none;
  border: none;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  position: relative;
  transition: color 0.2s ease;
}
.nav__link:hover { color: var(--accent); }

/* Stato attivo: testo accent + underline */
.nav__link.is-active { color: var(--accent); }
.nav__link.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 14px;
  right: 14px;
  height: 2px;
  background: var(--accent);
}

/* ── CHEVRON ───────────────────────────────────────────────────────────────── */
.nav__chevron {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  transition: transform 200ms ease;
}
.nav__item--mega.is-open .nav__chevron {
  transform: rotate(180deg);
}

/* ── MEGA-MENU ─────────────────────────────────────────────────────────────── */
.mega-menu {
  position: absolute;
  top: 72px;
  left: 0;
  width: 100%;
  background: var(--bg-card);
  border-top: 2px solid var(--accent);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.mega-menu.is-open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.mega-menu__inner {
  display: flex;
  align-items: stretch;
  padding-block: 32px;
  gap: 0;
}

/* ── Panel sinistro: immagine ──────────────────────────────────────────────── */
.mega-menu__panel {
  flex-shrink: 0;
  width: 260px;
  position: relative;
  overflow: hidden;
  border-radius: 2px;
  margin-right: 48px;
  text-decoration: none;
  display: block;
}
.mega-menu__panel-img {
  width: 100%;
  height: 100%;
  min-height: 200px;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 400ms ease;
}
.mega-menu__panel:hover .mega-menu__panel-img {
  transform: scale(1.05);
}
.mega-menu__panel-body {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
}
.mega-menu__panel-title {
  font-family: var(--font-head);
  font-size: 20px;
  color: var(--white);
  display: block;
  margin-bottom: 6px;
  line-height: 1;
}
.mega-menu__panel-sub {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--text-sub-60);
  line-height: 1.5;
  display: block;
  margin-bottom: 12px;
}
.mega-menu__panel-cta {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  display: block;
}

/* ── Colonne link ──────────────────────────────────────────────────────────── */
.mega-menu__col {
  flex: 1;
  padding-inline: 32px;
  border-left: 1px solid var(--border);
}
.mega-menu__col-label {
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 16px;
  max-width: none;
}
.mega-menu__col ul {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.mega-menu__col a {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--text-muted);
  transition: color 0.2s ease;
  display: block;
}
.mega-menu__col a:hover { color: var(--text); }

/* ── Burger ────────────────────────────────────────────────────────────────── */
.nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 101;
}
.nav__burger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text);
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.nav__burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav__burger.is-open span:nth-child(2) { opacity: 0; }
.nav__burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── MOBILE ────────────────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .nav__logo img { height: 52px; }

  .nav__bar { grid-template-columns: 1fr auto; }

  /* Overlay full-screen */
  .nav__links {
    position: fixed;
    inset: 0;
    background: var(--bg);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 99;
  }

  /* Glow rosso centrato sullo sfondo */
  .nav__links::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 90% 60% at 50% 50%, rgba(229, 51, 50, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .nav__links.is-open { transform: translateX(0); }

  .nav__item {
    border-bottom: none;
    text-align: center;
  }

  /* Simbolo ° decorativo sopra ogni voce */
  .nav__item::before {
    content: '°';
    display: block;
    font-size: 18px;
    line-height: 0.55;
    text-align: center;
    color: var(--accent);
    margin-bottom: 6px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Animazione ingresso a cascata — simboli (logo è nth-child 1, voci da 2 a 4) */
  .nav__links.is-open .nav__item:nth-child(2)::before { opacity: 1; transform: translateY(0); transition-delay: 0.15s; }
  .nav__links.is-open .nav__item:nth-child(3)::before { opacity: 1; transform: translateY(0); transition-delay: 0.25s; }
  .nav__links.is-open .nav__item:nth-child(4)::before { opacity: 1; transform: translateY(0); transition-delay: 0.35s; }

  .nav__link {
    font-family: var(--font-head);
    font-size: clamp(26px, 3.4vw, 56px);
    letter-spacing: 4px;
    padding: 8px 40px 16px;
    width: auto;
    justify-content: center;
    text-align: center;
    opacity: 0;
    transform: translateY(28px);
    transition: color 0.2s ease,
                opacity  0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Animazione ingresso a cascata — testi */
  .nav__links.is-open .nav__item:nth-child(2) .nav__link { opacity: 1; transform: translateY(0); transition-delay: 0.17s; }
  .nav__links.is-open .nav__item:nth-child(3) .nav__link { opacity: 1; transform: translateY(0); transition-delay: 0.27s; }
  .nav__links.is-open .nav__item:nth-child(4) .nav__link { opacity: 1; transform: translateY(0); transition-delay: 0.37s; }

  /* Linea che si espande dal centro all'hover */
  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 50%;
    right: auto;
    width: 28%;
    height: 2px;
    background: var(--accent);
    transform: translateX(-50%);
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav__link:hover::after  { width: 56%; }
  .nav__link.is-active::after { width: 56%; }

  .nav__cta { display: none; }
  .nav__burger { display: flex; }

  /* Mega → accordion */
  .mega-menu {
    position: static;
    opacity: 1;
    pointer-events: auto;
    transform: none;
    background: var(--bg-alt);
    border-bottom: none;
    box-shadow: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .mega-menu.is-open { max-height: 600px; }

  .mega-menu__inner {
    flex-direction: column;
    gap: 0;
    padding: 8px 24px 24px;
  }

  .mega-menu__panel { display: none; }

  .mega-menu__col {
    border-left: none;
    border-top: 1px solid var(--border);
    padding: 16px 0;
  }
  .mega-menu__col:first-of-type { border-top: none; padding-top: 8px; }

  .mega-menu__col-label { margin-bottom: 12px; }

  .mega-menu__col a {
    padding-block: 5px;
    font-size: 13px;
  }
}

/* Logo nell'overlay mobile — nascosto su desktop */
.nav__mobile-logo { display: none; }

@media (max-width: 768px) {
  .nav__mobile-logo {
    position: absolute;
    top: 10px;
    left: 24px;
    transform: translateY(-8px);
    display: flex;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav__links.is-open .nav__mobile-logo {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }
  .nav__mobile-logo img {
    height: 52px;
    width: auto;
  }
}

/* ── Desktop: mostra CTA nav, nascondile su mobile (la barra le sostituisce) ── */
.nav__cta.contact-trigger,
.nav__cta.gp-trigger { display: inline-flex; }
@media (max-width: 768px) {
  .nav__cta.contact-trigger,
  .nav__cta.gp-trigger { display: none; }
}

/* ── Barra pulsanti mobile (fixed in fondo) ── */
.nav__mobile-actions {
  display: none;
}
@media (max-width: 768px) {
  .nav__mobile-actions {
    display: flex;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 100;
    padding: 16px 20px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
    gap: 12px;
    background: var(--bg);
    border-top: 1px solid var(--border);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  .nav__mobile-actions.is-open {
    transform: translateY(0);
  }
  .nav__mob-btn {
    flex: 1;
    justify-content: center;
    text-align: center;
    font-size: 13px;
    padding: 14px 12px;
  }
}
</style>

<script>
const nav          = document.getElementById('nav')!;
const burger       = document.getElementById('nav-burger')!;
const linksList    = document.getElementById('nav-links')!;
const mobileActions = document.getElementById('nav-mobile-actions')!;

const megaItems = Array.from(nav.querySelectorAll<HTMLElement>('.nav__item--mega'));
const triggers  = Array.from(nav.querySelectorAll<HTMLButtonElement>('.nav__trigger'));

const closeTimers = new Map<HTMLElement, ReturnType<typeof setTimeout>>();

// ── Scroll ──
window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 10);
}, { passive: true });

// ── Helpers ──
const isMobile = () => window.innerWidth <= 768;

function openMega(item: HTMLElement) {
  const mega    = item.querySelector<HTMLElement>('.mega-menu')!;
  const trigger = item.querySelector<HTMLButtonElement>('.nav__trigger')!;
  item.classList.add('is-open');
  mega.classList.add('is-open');
  mega.setAttribute('aria-hidden', 'false');
  trigger.setAttribute('aria-expanded', 'true');
}

function closeMega(item: HTMLElement) {
  const mega    = item.querySelector<HTMLElement>('.mega-menu')!;
  const trigger = item.querySelector<HTMLButtonElement>('.nav__trigger')!;
  item.classList.remove('is-open');
  mega.classList.remove('is-open');
  mega.setAttribute('aria-hidden', 'true');
  trigger.setAttribute('aria-expanded', 'false');
}

function closeAll() {
  megaItems.forEach(item => closeMega(item));
}

// ── Desktop: hover con debounce ──
megaItems.forEach(item => {
  item.addEventListener('mouseenter', () => {
    if (isMobile()) return;
    const t = closeTimers.get(item);
    if (t) { clearTimeout(t); closeTimers.delete(item); }
    closeAll();
    openMega(item);
  });

  item.addEventListener('mouseleave', () => {
    if (isMobile()) return;
    const t = setTimeout(() => {
      closeMega(item);
      closeTimers.delete(item);
    }, 120);
    closeTimers.set(item, t);
  });
});

// ── Mobile: click trigger → accordion ──
triggers.forEach(trigger => {
  trigger.addEventListener('click', () => {
    if (!isMobile()) return;
    const item   = trigger.closest<HTMLElement>('.nav__item--mega')!;
    const isOpen = item.classList.contains('is-open');
    closeAll();
    if (!isOpen) openMega(item);
  });
});

// ── Burger ──
function closeMobileMenu() {
  burger.classList.remove('is-open');
  linksList.classList.remove('is-open');
  mobileActions.classList.remove('is-open');
  mobileActions.setAttribute('aria-hidden', 'true');
  burger.setAttribute('aria-expanded', 'false');
  closeAll();
}

burger.addEventListener('click', () => {
  const open = burger.classList.toggle('is-open');
  linksList.classList.toggle('is-open', open);
  mobileActions.classList.toggle('is-open', open);
  mobileActions.setAttribute('aria-hidden', String(!open));
  burger.setAttribute('aria-expanded', String(open));
  if (!open) closeAll();
});

// ── Chiudi al click su un link (mobile) ──
linksList.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', closeMobileMenu);
});

// ── Chiudi al click su Contattaci nella barra mobile ──
mobileActions.querySelectorAll('a, button').forEach(el => {
  el.addEventListener('click', closeMobileMenu);
});

// ── Click fuori → chiudi mega ──
document.addEventListener('click', e => {
  if (!nav.contains(e.target as Node)) closeAll();
});

// ── ESC → chiudi tutto ──
document.addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  closeMobileMenu();
});
</script>
