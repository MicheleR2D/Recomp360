---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">

    <!-- Col 1 — Logo + claim -->
    <div class="footer__brand">
      <a href={base} aria-label="Recomp360 home">
        <img src={`${base}images/logo.png`} alt="Recomp360" class="footer__logo" />
      </a>
      <p>La palestra ibrida di Roma.<br />Libertà + expertise, a 360°.</p>
    </div>

    <!-- Col 2 — Link utili -->
    <div class="footer__col">
      <h4>Navigazione</h4>
      <ul>
        <li><a href={`${base}about`}>Chi Siamo</a></li>
        <li><a href={`${base}metodo`}>Il Metodo</a></li>
        <li><a href={`${base}classi`}>Classi</a></li>
        <li><a href="#gym">Sala Pesi</a></li>
        <li><a href="#reviews">Recensioni</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/regolamento">Regolamento</a></li>
      </ul>
    </div>

    <!-- Col 3 — Contatti -->
    <div class="footer__col">
      <h4>Contatti</h4>
      <ul>
        <li class="footer__addr">Roma, Zona Prenestina</li>
        <li><button class="footer__link-btn contact-trigger">Richiedi Informazioni</button></li>
        <li><button class="footer__link-btn contact-trigger">Prenota la Prova</button></li>
      </ul>
    </div>

    <!-- Col 4 — Social / CTA -->
    <div class="footer__col">
      <h4>Seguici</h4>
      <div class="footer__social">
        <a href="https://instagram.com/recomp360/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://facebook.com/Recomp360/" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://youtube.com/@recomp360amministrazione6" target="_blank" rel="noopener" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
        </a>
      </div>
      <div class="neon-wrap">
        <button class="btn-primary footer__cta contact-trigger">
          Inizia Ora — €17
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>

  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>© {year} Recomp360. Tutti i diritti riservati. Roma, zona Prenestina.</p>
    </div>
  </div>
</footer>

<style>
/* ── Neon-wrap ── */
@property --angle {
  syntax: '<angle>';
  inherits: false;
  initial-value: 0deg;
}
@keyframes borderRotate {
  to { --angle: 360deg; }
}

.neon-wrap {
  position: relative;
  display: block;
  border-radius: 0;
}
.neon-wrap::before,
.neon-wrap::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 0;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent)  40%,
    #ff8080        50%,
    var(--white)   55%,
    var(--accent)  60%,
    transparent    80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.neon-wrap::after {
  filter: blur(8px);
  opacity: 0.6;
}

.footer {
  background: #000000;
  border-top: 1px solid var(--border);
  padding-top: 80px;
}

.footer__inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 60px;
  padding-bottom: 60px;
}

/* ── Col 1: Brand ── */
.footer__logo { height: 44px; width: auto; margin-bottom: 20px; }

.footer__brand p {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 260px;
}

/* ── Col 2–4: standard columns ── */
.footer__col h4 {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 24px;
}

.footer__col ul { display: flex; flex-direction: column; gap: 12px; }

.footer__col a {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 400;
  color: var(--text-muted);
  transition: color 200ms ease;
}

.footer__col a:hover { color: var(--text); }

.footer__link-btn {
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--text-muted);
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  text-align: left;
  transition: color 0.2s;
}
.footer__link-btn:hover { color: var(--text); }

.footer__addr {
  font-size: 14px;
  color: var(--text-muted);
  font-style: normal;
}

/* ── Col 4: Social / CTA ── */
.footer__social {
  display: flex;
  gap: 12px;
  margin-bottom: 28px;
}

.footer__social a {
  width: 40px;
  height: 40px;
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  transition: border-color 200ms ease, color 200ms ease;
}

.footer__social a:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.footer__social svg { width: 18px; height: 18px; }

.footer__cta {
  position: relative;
  z-index: 1;
  width: 100%;
  justify-content: center;
  background: var(--bg-card);
  white-space: nowrap;
}
.footer__cta:hover { background: var(--bg-card); }

/* ── Bottom bar ── */
.footer__bottom {
  border-top: 1px solid var(--border);
  padding-block: 24px;
}

.footer__bottom p {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  color: var(--text-muted);
  max-width: none;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .footer__inner {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
}

@media (max-width: 560px) {
  .footer__inner {
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .footer__cta { width: auto; justify-content: flex-start; }
}
</style>
