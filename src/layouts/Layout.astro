---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const SITE = 'https://www.recomp360.it';

const {
  title       = 'Palestra Roma Est Prenestina | Recomp360 — Personal Training & Sala Pesi',
  description = 'Recomp360 è la palestra di Roma Est in zona Prenestina con personal training, sala pesi, corsi fitness e percorsi personalizzati. Prova 7 allenamenti a €17.',
  image       = '/images/og/og-home.jpg',
  canonical,
  noindex     = false,
} = Astro.props;

// OG image: se assoluto usalo as-is, altrimenti costruisce dall'origine corrente
// (funziona su Netlify preview, staging e produzione senza toccare nulla)
const ogImage = image.startsWith('http') ? image : `${Astro.url.origin}${image}`;

const canonicalUrl = canonical ?? `${SITE}${Astro.url.pathname.replace(/\/$/, '') || '/'}`;
const base = import.meta.env.BASE_URL;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HealthClub",
  "@id": `${SITE}/#healthclub`,
  "name": "Recomp360",
  "description": "Palestra di Roma Est in zona Prenestina con personal training, sala pesi, corsi fitness e percorsi personalizzati di ricomposizione corporea.",
  "url": SITE,
  "telephone": "+393273672361",
  "email": "info@recomp360.it",
  "image": `${SITE}/images/og/og-home.jpg`,
  "logo": `${SITE}/images/logo%20recomp360.png`,
  "priceRange": "€-€€",
  "currenciesAccepted": "EUR",
  "makesOffer": {
    "@type": "Offer",
    "name": "Prova 7 allenamenti",
    "description": "Pacchetto di prova: 7 allenamenti presso Recomp360 a €17.",
    "price": "17",
    "priceCurrency": "EUR",
    "url": SITE
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Via Prenestina 278 B",
    "addressLocality": "Roma",
    "addressRegion": "RM",
    "postalCode": "00177",
    "addressCountry": "IT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.8862,
    "longitude": 12.5483
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "07:00",
      "closes": "23:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "10:00",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Sunday",
      "opens": "10:00",
      "closes": "14:00"
    }
  ],
  "sameAs": [
    "https://www.instagram.com/recomp360/",
    "https://www.facebook.com/Recomp360/",
    "https://www.youtube.com/@recomp360amministrazione6"
  ],
  "hasMap": "https://maps.google.com/?q=Via+Prenestina+278+B,+00177+Roma"
};
---

<!doctype html>
<html lang="it">
  <head>
    <!-- Google Consent Mode v2 — default denied (DEVE precedere GTM) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'functionality_storage': 'denied',
        'personalization_storage': 'denied',
        'security_storage': 'granted',
        'wait_for_update': 500
      });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TH6NJF4Z');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0A0A" />

    <!-- SEO base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    }
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Recomp360" />
    <meta property="og:locale"      content="it_IT" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content="Recomp360 — Palestra Roma Est Prenestina" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Preload font critico -->
    <link rel="preload" href={`${base}fonts/MicrogrammaDExtendedBold.otf`} as="font" type="font/otf" crossorigin="anonymous" />

    <!-- JSON-LD LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- CookieYes -->
    <script is:inline id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/841a9301a43ba34feef5121bc5de9090/script.js"></script>

    <!-- Font Microgramma -->
    <Fragment set:html={`<style>@font-face{font-family:'Microgramma';src:url('${base}fonts/MicrogrammaDExtendedBold.otf') format('opentype');font-weight:700;font-style:normal;font-display:swap;}</style>`} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TH6NJF4Z"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
