---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const TYPEFORM_URL  = 'https://zgcrbhl8m6b.typeform.com/InfoBody';
const base = import.meta.env.BASE_URL;

const classes = [
  { name: 'Cross Cardio',        img: 'DSC02203-scaled.jpg' },
  { name: 'Functional Training', img: 'DSC02203-scaled.jpg' },
  { name: 'Interval Training',   img: '1000204789-scaled.jpg' },
  { name: 'Met-Con',             img: '1000204833-scaled.jpg' },
  { name: 'Pilates',             img: '1000204752-scaled.jpg' },
  { name: 'Postural',            img: 'DSC02345-scaled.jpg' },
  { name: 'Pre-Boxing',          img: '1000204833-scaled.jpg' },
  { name: 'Zumba',               img: '1000204752-scaled.jpg' },
];

const reviews = [
  { name: 'Marco T.',       stars: 5, text: 'In 3 mesi ho raggiunto risultati che non pensavo possibili. Il metodo funziona davvero.' },
  { name: 'Giulia R.',      stars: 5, text: 'Non è solo una palestra. Ti seguono a 360 gradi: allenamento, alimentazione, postura.' },
  { name: 'Alessandro M.',  stars: 5, text: 'Valutazione tecnica iniziale fondamentale. Capisci subito dove vuoi arrivare e come.' },
];
---

<Layout>
  <Nav />

  <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
  <section id="hero" class="hero">
    <div class="hero__bg">
      <video class="hero__video" autoplay muted loop playsinline poster={`${base}images/hero-poster.jpg`}>
        <source src={`${base}video/hero.mp4`} type="video/mp4" />
      </video>
      <div class="hero__overlay"></div>
    </div>
    <div class="container hero__content">
      <h1 class="hero__title">
        IL METODO CHE<br />
        <span class="text-accent">TRASFORMA</span><br />
        I TUOI OBIETTIVI
      </h1>
      <p class="hero__sub">Non una palestra. Un metodo.</p>
      <div class="hero__ctas">
        <a href={TYPEFORM_URL} target="_blank" rel="noopener" class="btn btn--primary">
          Inizia Ora — €17
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="#philosophy" class="btn btn--outline">Scopri di Più</a>
      </div>
    </div>
    <div class="hero__scroll"><div class="hero__scroll-line"></div><span>Scroll</span></div>
  </section>

  <!-- ─── PHILOSOPHY ────────────────────────────────────────────────────── -->
  <section id="philosophy" class="section">
    <div class="container">

      <!-- Riga superiore: testo sinistra, immagine destra -->
      <div class="philosophy__grid">
        <div class="philosophy__text-col">
          <p class="section__label">Chi Siamo</p>
          <h2>PALESTRA.<br />MA NON SOLO.<br /><span class="text-accent">360°.</span></h2>
          <div class="divider"></div>
          <p class="philosophy__text">
            Libertà della sala attrezzi + expertise del personal training studio.
            Un team di specialisti — trainer, nutrizionista, fisioterapista — per seguirti davvero a tutto tondo.
          </p>
          <a href="/about" class="btn btn--ghost" style="margin-top:32px">
            Chi siamo
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
        <div class="philosophy__image-col">
          <img src={`${base}images/pt-session.jpg`} alt="Personal training session Recomp360" class="philosophy__img" />
        </div>
      </div>

      <!-- Riga inferiore: 4 stat inline -->
      <div class="stats-row">
        <div class="stat-card"><span class="stat-card__value">360°</span><span class="stat-card__label">Cura del percorso</span></div>
        <div class="stat-card"><span class="stat-card__value">8+</span><span class="stat-card__label">Discipline</span></div>
        <div class="stat-card"><span class="stat-card__value">100%</span><span class="stat-card__label">Last-gen</span></div>
        <div class="stat-card"><span class="stat-card__value">5★</span><span class="stat-card__label">Media clienti</span></div>
      </div>

    </div>
  </section>

  <!-- ─── MYRECOMP ──────────────────────────────────────────────────────── -->
  <section id="myrecomp" class="section section--alt">
    <div class="container">

      <!-- Header con CTA a destra -->
      <div class="method-header">
        <div>
          <p class="section__label">Il Metodo Proprietario</p>
          <h2>MY<span class="text-accent">RECOMP</span></h2>
          <div class="divider"></div>
          <p style="margin-top:16px">Ricomposizione corporea strutturata. Valutazione tecnica, percorso progressivo, risultati misurabili.</p>
        </div>
        <a href="/metodo" class="btn btn--outline method-header__cta">
          Scopri il Metodo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Card con immagini -->
      <div class="method-grid">
        <div class="method-card method-card--featured">
          <div class="method-card__img-wrap">
            <img src={`${base}images/myrecomp-pt.jpg`} alt="Personal Training Recomp360" class="method-card__img" />
          </div>
          <div class="method-card__body">
            <span class="badge">Core</span>
            <h3>Personal Training</h3>
            <p>Sessioni 1:1 con trainer dedicato, scheda su misura.</p>
          </div>
        </div>
        <div class="method-card">
          <div class="method-card__img-wrap">
            <img src={`${base}images/myrecomp-group.jpg`} alt="Small Group Training Recomp360" class="method-card__img" />
          </div>
          <div class="method-card__body">
            <span class="badge badge--muted">Gruppo</span>
            <h3>Small Group</h3>
            <p>Max 6 persone per sessione. Efficacia PT, energia di gruppo.</p>
          </div>
        </div>
        <div class="method-card">
          <div class="method-card__img-wrap">
            <img src={`${base}images/myrecomp-sala.jpg`} alt="Sala Attrezzi Recomp360" class="method-card__img" />
          </div>
          <div class="method-card__body">
            <span class="badge badge--muted">Accesso</span>
            <h3>Sala Libera</h3>
            <p>Attrezzatura last-gen, zone funzionali, staff sempre presente.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── CLASSES ───────────────────────────────────────────────────────── -->
  <section id="classes" class="section">
    <div class="container">
      <div class="classes-header">
        <div>
          <p class="section__label">Attività di Gruppo</p>
          <h2>CLASSI <span class="text-accent">FITNESS</span></h2>
          <div class="divider"></div>
        </div>
        <a href="/classi" class="btn btn--outline classes-header__cta">
          Orari e Iscrizioni
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="classes-grid">
        {classes.map(c => (
          <div class="class-tile">
            <div class="class-tile__img-wrap">
              <img src={`${base}images/${c.img}`} alt={c.name} class="class-tile__img" />
            </div>
            <h4>{c.name}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── GYM ───────────────────────────────────────────────────────────── -->
  <section id="gym" class="section section--alt">
    <div class="container">
      <div class="gym__grid">
        <div class="gym__image-stack">
          <img src={`${base}images/gym-pesi.jpg`} alt="Sala pesi Recomp360" class="gym__img gym__img--lg" />
          <img src={`${base}images/gym-sacco.jpg`} alt="Zona boxe Recomp360" class="gym__img" />
          <img src={`${base}images/gym-cardio.jpg`} alt="Zona cardio Recomp360" class="gym__img" />
        </div>
        <div class="gym__text">
          <p class="section__label">Sala Attrezzi</p>
          <h2>ATTREZZATURA<br /><span class="text-accent">LAST-GEN</span></h2>
          <div class="divider"></div>
          <ul class="gym-features">
            <li><span class="check-icon">✓</span> Macchinari di ultima generazione</li>
            <li><span class="check-icon">✓</span> Zone dedicate functional + metabolico</li>
            <li><span class="check-icon">✓</span> Ambiente pulito, curato, moderno</li>
            <li><span class="check-icon">✓</span> Staff qualificato sempre presente</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── OFFER ─────────────────────────────────────────────────────────── -->
  <section id="offer" class="section offer-section">
    <div class="container offer-section__inner">
      <div class="offer-section__text">
        <p class="section__label" style="color:var(--text-muted)">Inizia Adesso</p>
        <h2>PROVA<br />RECOMP360<br /><span class="text-accent">A €17</span></h2>
        <div class="divider"></div>
        <p style="margin-top:24px;color:var(--text-muted)">
          7 allenamenti + valutazione tecnica inclusa.<br />Valido 14 giorni dall'attivazione.
        </p>
      </div>
      <div class="offer-section__cta">
        <ul class="offer-list">
          <li><span>✓</span> 7 sessioni di allenamento</li>
          <li><span>✓</span> Valutazione tecnica inclusa</li>
          <li><span>✓</span> Accesso a tutte le zone</li>
          <li><span>✓</span> 14 giorni dall'attivazione</li>
        </ul>
        <a href={TYPEFORM_URL} target="_blank" rel="noopener" class="btn btn--primary offer-btn">
          Attiva la Prova — €17
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── REVIEWS ──────────────────────────────────────────────────────── -->
  <section id="reviews" class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__label">Recensioni</p>
        <h2>COSA DICONO<br /><span class="text-accent">I NOSTRI CLIENTI</span></h2>
        <div class="divider"></div>
      </div>
      <div class="reviews-grid">
        {reviews.map(r => (
          <div class="review-card">
            <div class="review-card__stars">{'★'.repeat(r.stars)}</div>
            <p class="review-card__text">"{r.text}"</p>
            <strong class="review-card__name">{r.name}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── FOOTER ────────────────────────────────────────────────────────── -->
  <Footer />
</Layout>

<style>
/* ── HERO ──────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.hero__bg { position: absolute; inset: 0; z-index: 0; }
.hero__video { width: 100%; height: 100%; object-fit: cover; }
.hero__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(10,10,10,0.88) 0%, rgba(10,10,10,0.5) 100%);
}
.hero__content {
  position: relative; z-index: 1;
  padding-top: 100px; padding-bottom: 60px;
}
.hero__title { color: #fff; line-height: 0.95; margin-bottom: 24px; }
.hero__sub {
  font-size: 20px; color: rgba(240,240,240,0.6);
  margin-bottom: 40px; max-width: 320px;
}
.hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; }
.hero__scroll {
  position: absolute; bottom: 40px; left: 50%;
  transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  z-index: 1;
}
.hero__scroll span { font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: rgba(240,240,240,0.3); }
.hero__scroll-line {
  width: 1px; height: 48px;
  background: linear-gradient(to bottom, var(--accent), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse { 0%,100%{opacity:.4} 50%{opacity:1} }

/* ── PHILOSOPHY ────────────────────────────────────────────────────────────── */
.philosophy__grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 64px; align-items: center;
  margin-bottom: 48px;
}
.philosophy__text {
  margin-top: 24px; font-size: 17px;
  color: var(--text-muted); line-height: 1.7;
  max-width: 480px;
}
.philosophy__image-col { position: relative; }
.philosophy__img {
  width: 100%; height: 480px;
  object-fit: cover; object-position: center top;
  border-radius: var(--radius-lg);
  display: block;
}

/* Stat row — 4 card inline sotto testo+immagine */
.stats-row {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
}
.stat-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 28px 20px; text-align: center;
  transition: border-color .2s;
}
.stat-card:hover { border-color: var(--accent); }
.stat-card__value {
  display: block; font-family: var(--font-head);
  font-size: 44px; color: var(--accent); letter-spacing: 1px; line-height: 1;
}
.stat-card__label {
  display: block; font-size: 11px; font-weight: 600;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--text-muted); margin-top: 8px;
}

/* ── MYRECOMP ──────────────────────────────────────────────────────────────── */
.method-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; margin-bottom: 40px;
}
.method-header__cta { flex-shrink: 0; }

.method-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 20px;
}
.method-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden;
  transition: border-color .2s, transform .2s;
}
.method-card:hover { border-color: var(--accent); transform: translateY(-3px); }
.method-card--featured { border-color: rgba(229,51,50,0.4); }

.method-card__img-wrap { overflow: hidden; }
.method-card__img {
  width: 100%; height: 220px;
  object-fit: cover; object-position: center;
  display: block;
  transition: transform .4s ease;
}
.method-card:hover .method-card__img { transform: scale(1.04); }

.method-card__body { padding: 24px 28px 28px; }
.method-card__body h3 { margin: 14px 0 8px; }
.method-card__body p { font-size: 15px; color: var(--text-muted); }

.badge {
  display: inline-block; font-size: 10px; font-weight: 700;
  letter-spacing: 3px; text-transform: uppercase;
  color: var(--accent); border: 1px solid var(--accent);
  border-radius: 100px; padding: 4px 12px;
}
.badge--muted { color: var(--text-muted); border-color: var(--border); }

/* ── CLASSES ───────────────────────────────────────────────────────────────── */
.classes-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; margin-bottom: 40px;
}
.classes-header__cta { flex-shrink: 0; }

.classes-grid {
  display: grid; grid-template-columns: repeat(4,1fr); gap: 14px;
}
.class-tile {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); overflow: hidden;
  transition: border-color .2s, transform .2s;
}
.class-tile:hover { border-color: var(--accent); transform: translateY(-2px); }
.class-tile__img-wrap { overflow: hidden; }
.class-tile__img {
  width: 100%; height: 160px;
  object-fit: cover; object-position: center;
  display: block;
  transition: transform .4s ease;
}
.class-tile:hover .class-tile__img { transform: scale(1.04); }
.class-tile h4 { font-size: 14px; letter-spacing: 0.5px; padding: 16px 20px; }

/* ── GYM ───────────────────────────────────────────────────────────────────── */
.gym__grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 72px; align-items: center;
}
.gym__image-stack {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
}
.gym__img {
  width: 100%; height: 200px;
  object-fit: cover; object-position: center;
  border-radius: var(--radius-lg); display: block;
}
.gym__img--lg { grid-column: 1 / -1; height: 280px; }
.gym-features { display: flex; flex-direction: column; gap: 14px; margin-top: 32px; }
.gym-features li {
  display: flex; align-items: center; gap: 10px;
  font-size: 15px; color: var(--text-muted); list-style: none;
}
.check-icon { color: var(--accent); font-weight: 700; flex-shrink: 0; }
.gym__text .divider { margin-top: 20px; }

/* ── OFFER ─────────────────────────────────────────────────────────────────── */
.offer-section { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.offer-section__inner {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 80px; align-items: center;
}
.offer-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 36px; }
.offer-list li {
  display: flex; align-items: center; gap: 10px;
  font-size: 15px; color: var(--text-muted);
}
.offer-list span { color: var(--accent); font-weight: 700; }
.offer-btn { width: 100%; justify-content: center; }

/* ── REVIEWS ───────────────────────────────────────────────────────────────── */
.reviews-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 20px;
}
.review-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 32px 28px;
  transition: border-color .2s;
}
.review-card:hover { border-color: var(--accent); }
.review-card__stars { color: #FFD600; font-size: 16px; letter-spacing: 2px; margin-bottom: 16px; }
.review-card__text {
  font-size: 15px; color: var(--text-muted);
  font-style: italic; line-height: 1.7; margin-bottom: 20px;
}
.review-card__name { font-size: 13px; font-weight: 700; color: var(--text); }

/* ── TEXT ACCENT ───────────────────────────────────────────────────────────── */
.text-accent { color: var(--accent); }

/* ── RESPONSIVE ────────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .classes-grid  { grid-template-columns: repeat(2,1fr); }
  .method-grid   { grid-template-columns: 1fr; max-width: 520px; }
  .method-header  { flex-direction: column; align-items: flex-start; }
  .classes-header { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 900px) {
  .philosophy__grid     { grid-template-columns: 1fr; gap: 40px; }
  .philosophy__img      { height: 320px; }
  .stats-row            { grid-template-columns: repeat(2, 1fr); }
  .gym__grid            { grid-template-columns: 1fr; gap: 48px; }
  .reviews-grid         { grid-template-columns: 1fr; }
  .offer-section__inner { grid-template-columns: 1fr; gap: 40px; }
}
@media (max-width: 640px) {
  .classes-grid { grid-template-columns: repeat(2,1fr); }
  .stats-row    { grid-template-columns: repeat(2,1fr); }
  .hero__ctas   { flex-direction: column; }
  .hero__ctas .btn { width: 100%; justify-content: center; }
}
</style>
