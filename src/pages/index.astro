  .stats-row            { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gym3d__viewport      { height: 260px; }
  .gym3d__card          { width: 70%; }
  .gym3d::before, .gym3d::after { height: 260px; width: 60px; }
  .reviews-intro        { grid-template-columns: 1fr; gap: 32px; }
