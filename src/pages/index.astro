  .hero__ctas .btn-outline { width: 100%; justify-content: center; }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .reveal, .hero__eyebrow, .hero__line, .hero__sub, .hero__ctas, .hero__scroll,
  .hero__glitch, .hero__glitch::before, .hero__glitch::after,
  .anim-divider, .btn-primary::after { animation: none !important; transition: none !important; }
  .reveal { opacity: 1; transform: none; }
  .anim-divider { width: 48px !important; }
}
</style>

<script>
// ── PARTICLES ───────────────────────────────────────────────────────────────
(function () {
  const canvas = document.getElementById('hero-particles');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  const COUNT = 70;
  const particles = Array.from({ length: COUNT }, () => ({
    x:      Math.random() * window.innerWidth,
    y:      Math.random() * window.innerHeight,
    r:      Math.random() * 1.8 + 0.4,
    vx:     (Math.random() - 0.5) * 0.35,
    vy:     (Math.random() - 0.5) * 0.35,
    alpha:  Math.random() * 0.35 + 0.05,
  }));

  function tick() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width)  p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(229,51,50,${p.alpha})`;
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  tick();
})();

// ── SCROLL REVEAL + DIVIDER DRAW + COUNTER ──────────────────────────────────
(function () {
  const revealEls = document.querySelectorAll('.reveal');
  const dividerEls = document.querySelectorAll('.anim-divider');
  const counterEls = document.querySelectorAll('[data-count]');
  const animated = new WeakSet();

  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

  function animateCounter(el) {
    if (animated.has(el)) return;
    animated.add(el);
    const target = parseInt(el.dataset.count, 10);
    const suffix = el.dataset.suffix || '';
    const dur = 1400;
    const start = performance.now();
    function frame(now) {
      const t = Math.min((now - start) / dur, 1);
      el.textContent = Math.round(easeOutCubic(t) * target) + suffix;
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target;
      el.classList.add('visible');
      if (el.classList.contains('anim-divider')) el.classList.add('drawn');
      io.unobserve(el);
    }
  }, { threshold: 0.15 });

  const counterIo = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      animateCounter(e.target);
      counterIo.unobserve(e.target);
    }
  }, { threshold: 0.4 });

  revealEls.forEach(el => io.observe(el));
  dividerEls.forEach(el => io.observe(el));
  counterEls.forEach(el => counterIo.observe(el));
})();

// ── 3D TILT ON CARDS ────────────────────────────────────────────────────────
(function () {
  const MAX = 9;
  document.querySelectorAll('.tilt-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      const y = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      card.style.transform = `perspective(700px) rotateY(${x * MAX}deg) rotateX(${-y * MAX}deg) translateY(-4px)`;
      card.style.transition = 'transform 0.1s ease, border-color 0.3s ease, box-shadow 0.3s ease';
    }, { passive: true });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'transform 0.5s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, box-shadow 0.3s ease';
    });
  });
})();

// ── MAGNETIC BUTTONS ────────────────────────────────────────────────────────
(function () {
  const STRENGTH = 0.35;
  document.querySelectorAll('.magnetic').forEach(btn => {
    btn.addEventListener('mousemove', (e) => {
      const r = btn.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width  / 2);
      const dy = e.clientY - (r.top  + r.height / 2);
      btn.style.transform = `translate(${dx * STRENGTH}px, ${dy * STRENGTH}px)`;
      btn.style.transition = 'transform 0.15s ease';
    }, { passive: true });
    btn.addEventListener('mouseleave', () => {
      btn.style.transform = '';
      btn.style.transition = 'transform 0.5s cubic-bezier(0.16,1,0.3,1)';
    });
  });
})();

// ── CLASSES CAROUSEL ────────────────────────────────────────────────────────
(function () {
  const track    = document.getElementById('cls-track');
  const viewport = document.getElementById('cls-viewport');
  const dotsWrap = document.getElementById('cls-dots');
  const btnPrev  = document.getElementById('cls-prev');
  const btnNext  = document.getElementById('cls-next');
  if (!track || !dotsWrap) return;

  const slides = track.querySelectorAll('.carousel-slide');
  const total  = slides.length;
  let current  = 0;
  let autoId   = null;

  function getVisible() {
    const w = window.innerWidth;
    return w > 1024 ? 4 : w > 640 ? 3 : 2;
  }

  function getMax() { return Math.max(0, total - getVisible()); }

  function slideWidth() {
    return slides[0].offsetWidth + 16; // 16 = gap
  }

  function goTo(idx) {
    current = Math.max(0, Math.min(idx, getMax()));
    track.style.transform = `translateX(-${current * slideWidth()}px)`;
    dotsWrap.querySelectorAll('.carousel-dot').forEach((d, i) =>
      d.classList.toggle('active', i === current)
    );
    btnPrev.disabled = current === 0;
    btnNext.disabled = current >= getMax();
  }

  function buildDots() {
    dotsWrap.innerHTML = '';
    const count = getMax() + 1;
    for (let i = 0; i < count; i++) {
      const d = document.createElement('button');
      d.className = 'carousel-dot' + (i === 0 ? ' active' : '');
      d.setAttribute('aria-label', `Slide ${i + 1}`);
      d.addEventListener('click', () => { goTo(i); resetAuto(); });
      dotsWrap.appendChild(d);
    }
  }

  function resetAuto() {
    clearInterval(autoId);
    autoId = setInterval(() => {
      goTo(current >= getMax() ? 0 : current + 1);
    }, 4000);
  }

  btnPrev.addEventListener('click', () => { goTo(current - 1); resetAuto(); });
  btnNext.addEventListener('click', () => { goTo(current + 1); resetAuto(); });

  // Pause on hover
  viewport.addEventListener('mouseenter', () => clearInterval(autoId));
  viewport.addEventListener('mouseleave', resetAuto);

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { buildDots(); goTo(Math.min(current, getMax())); }, 150);
  }, { passive: true });

  buildDots();
  goTo(0);
  resetAuto();
})();

// ── GYM 3D SPATIAL CAROUSEL ──────────────────────────────────────────────────
(function () {
  const stage   = document.getElementById('gym3d-stage');
  const dotsWrap = document.getElementById('gym3d-dots');
  const btnPrev = document.getElementById('gym3d-prev');
  const btnNext = document.getElementById('gym3d-next');
  if (!stage) return;

  const cards = Array.from(stage.querySelectorAll('.gym3d__card'));
  const total = cards.length;
  let current = 0, autoId = null;

  function positionCards() {
    const stageW = stage.offsetWidth;
    const cardW  = cards[0].offsetWidth;
    const centerX = (stageW - cardW) / 2;
    // Side offset: how far from center the ±1 card sits (px)
    const sideShift = stageW * (window.innerWidth <= 640 ? 0.36 : 0.44);

    cards.forEach((card, i) => {
      let off = i - current;
      if (off >  total / 2) off -= total;
      if (off < -total / 2) off += total;
      const abs = Math.abs(off);
      const dir = Math.sign(off) || 1;

      if (abs === 0) {
        card.style.transform  = `translateX(${centerX}px) rotateY(0deg) scale(1)`;
        card.style.opacity    = '1';
        card.style.zIndex     = '5';
        card.style.boxShadow  = '0 28px 80px rgba(0,0,0,0.75), 0 0 60px rgba(229,51,50,0.22), 0 0 0 1px rgba(229,51,50,0.12)';
        card.style.pointerEvents = 'none';
      } else if (abs === 1) {
        const x = centerX + dir * sideShift;
        card.style.transform  = `translateX(${x}px) rotateY(${-dir * 30}deg) scale(0.78)`;
        card.style.opacity    = '0.52';
        card.style.zIndex     = '3';
        card.style.boxShadow  = 'none';
        card.style.pointerEvents = 'auto';
      } else {
        const x = centerX + dir * sideShift * 1.7;
        card.style.transform  = `translateX(${x}px) rotateY(${-dir * 48}deg) scale(0.55)`;
        card.style.opacity    = '0';
        card.style.zIndex     = '1';
        card.style.pointerEvents = 'none';
      }
    });

    dotsWrap.querySelectorAll('.gym3d__dot').forEach((d, i) =>
      d.classList.toggle('active', i === current)
    );
  }

  function goTo(idx) {
    current = ((idx % total) + total) % total;
    positionCards();
  }

  function buildDots() {
    dotsWrap.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const d = document.createElement('button');
      d.className = 'gym3d__dot' + (i === 0 ? ' active' : '');
      d.setAttribute('aria-label', `Foto ${i + 1}`);
      d.addEventListener('click', () => { goTo(i); resetAuto(); });
      dotsWrap.appendChild(d);
    }
  }

  function resetAuto() {
    clearInterval(autoId);
    autoId = setInterval(() => goTo(current + 1), 4200);
  }

  btnPrev.addEventListener('click', () => { goTo(current - 1); resetAuto(); });
  btnNext.addEventListener('click', () => { goTo(current + 1); resetAuto(); });

  // Click side cards to navigate directly
  cards.forEach((card, i) => {
    card.addEventListener('click', () => { if (i !== current) { goTo(i); resetAuto(); } });
  });

  // Pause on hover
  stage.addEventListener('mouseenter', () => clearInterval(autoId));
  stage.addEventListener('mouseleave', resetAuto);

  // Touch swipe
  let tx = 0;
  stage.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 40) { goTo(dx < 0 ? current + 1 : current - 1); resetAuto(); }
  }, { passive: true });

  // Reposition on resize
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(positionCards, 120);
  }, { passive: true });

  buildDots();
  positionCards();
  resetAuto();
})();

// ── HERO VIDEO MOBILE FORCE-PLAY ─────────────────────────────────────────────
(function () {
  const video = document.querySelector('.hero__video');
  if (!video) return;
  const tryPlay = () => video.play().catch(() => {});
  // Script runs after DOM is ready — call immediately, then retry on first touch as fallback
  tryPlay();
  document.addEventListener('touchstart', tryPlay, { once: true, passive: true });
})();

// ── HERO VIDEO PARALLAX ─────────────────────────────────────────────────────
(function () {
  const video = document.querySelector('.hero__video');
  if (!video) return;
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      if (y < window.innerHeight) {
        video.style.transform = `translateY(${y * 0.25}px)`;
      }
      ticking = false;
    });
  }, { passive: true });
})();
</script>
