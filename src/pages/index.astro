@media (max-width: 640px) {
  /* Carosello: 1 slide a schermo, frecce rosse affiancate ai dots */
  .carousel-slide { flex: 0 0 100%; }
  .carousel-arrow--prev,
  .carousel-arrow--next {
    display: flex;
    background: var(--accent);
