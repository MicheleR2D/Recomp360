  .gym3d::before, .gym3d::after { height: 230px; width: 36px; }
  .stats-row             { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat-card__value      { font-size: 32px; }
  .hero__ctas            { flex-direction: column; }
