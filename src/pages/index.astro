---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GuestPassModal from '../components/GuestPassModal.astro';
import ContactModal from '../components/ContactModal.astro';

const base = import.meta.env.BASE_URL;

const classes = [
  { name: 'Cross Cardio',        desc: 'Cardio ad alta intensità, brucia calorie al massimo',         icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>' },
  { name: 'Functional Training', desc: 'Movimenti funzionali, forza e coordinazione completa',        icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M6.5 6.5h11M6.5 17.5h11M3 9h3v6H3zM18 9h3v6h-3zM6 9v6M18 9v6"/></svg>' },
  { name: 'Interval Training',   desc: 'Intervalli esplosivi per performance al top',                 icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><circle cx="12" cy="13" r="8"/><polyline points="12 9 12 13 15 15"/><path d="M9 2h6M12 2v3"/></svg>' },
  { name: 'Met-Con',             desc: 'Metabolic conditioning: velocità + resistenza',               icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M12 2c-4 5-6 8-6 12a6 6 0 0012 0c0-4-2-7-6-12zm0 0c0 4-4 7-4 10"/></svg>' },
  { name: 'Pilates',             desc: 'Core, stabilità e controllo del corpo',                       icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><circle cx="12" cy="5" r="2"/><path d="M12 7v6M9 22l3-8 3 8M9 13c-2 1-3.5 1-5 0M15 13c2 1 3.5 1 5 0"/></svg>' },
  { name: 'Postural',            desc: 'Postura corretta, mobilità e prevenzione',                    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><line x1="12" y1="2" x2="12" y2="22"/><polyline points="8 6 12 2 16 6"/><polyline points="8 18 12 22 16 18"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="10" y1="17" x2="14" y2="17"/></svg>' },
  { name: 'Pre-Boxing',          desc: 'Tecniche di boxe, coordinazione e cardio',                    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><rect x="3" y="9" width="14" height="10" rx="3"/><path d="M17 11h1a3 3 0 010 6h-1"/><line x1="7" y1="9" x2="7" y2="5"/><line x1="11" y1="9" x2="11" y2="5"/><line x1="7" y1="5" x2="11" y2="5"/></svg>' },
  { name: 'Zumba',               desc: 'Danza, ritmo e benessere con il sorriso',                     icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>' },
];

const gymPhotos = [
  { src: 'Sala Attrezzi Recomp.jpg',    alt: 'Sala pesi e attrezzi palestra Recomp360 Via Prenestina Roma Est' },
  { src: 'Sala Attrezzi Recomp (1).jpg', alt: 'Zona functional training palestra Recomp360 Roma Prenestina' },
  { src: 'Sala Attrezzi Recomp (2).jpg', alt: 'Attrezzature professionali sala pesi Recomp360 Roma Est' },
  { src: 'Sala Attrezzi Recomp (3).jpg', alt: 'Spazi allenamento palestra Recomp360 zona Prenestina Roma' },
  { src: 'Sala Attrezzi Recomp (4).jpg', alt: 'Macchinari professionali sala pesi Recomp360 Roma Est' },
  { src: 'Sala Attrezzi Recomp (5).jpg', alt: 'Sala attrezzi completa Recomp360 palestra Roma Est Prenestina' },
];

const reviews = [
  { name: 'Marco T.',       stars: 5, text: 'In 3 mesi ho raggiunto risultati che non pensavo possibili. Il metodo funziona davvero.' },
  { name: 'Giulia R.',      stars: 5, text: 'Non è solo una palestra. Ti seguono a 360 gradi: allenamento, alimentazione, postura.' },
  { name: 'Alessandro M.',  stars: 5, text: 'Valutazione tecnica iniziale fondamentale. Capisci subito dove vuoi arrivare e come.' },
];
---

<Layout
  title="Palestra Roma Est Prenestina | Recomp360 — Personal Training & Sala Pesi"
  description="Recomp360 è la palestra di Roma Est in zona Prenestina. Personal training, sala pesi, corsi fitness e percorsi personalizzati di ricomposizione corporea. Prova 7 allenamenti a €17."
  image="/images/og/og-home.jpg"
  canonical="https://www.recomp360.it/"
>
  <Nav />

  <!-- ─── HERO ──────────────────────────────────────────────────────────── -->
  <section id="hero" class="hero">
    <div class="hero__bg">
      <video class="hero__video" autoplay muted playsinline webkit-playsinline poster={`${base}images/hero-poster.jpg`}>
        <source src={`${base}video/hero.mp4`} type="video/mp4" />
      </video>
      <img src={`${base}images/hero-poster.jpg`} alt="" class="hero-bg-img" aria-hidden="true" />
      <div class="hero__overlay"></div>
    </div>
    <canvas id="hero-particles" aria-hidden="true"></canvas>
    <div class="container hero__content">
      <h1 class="hero__title">
        <span class="hero__line hero__line--1">IL METODO CHE</span><br />
        <span class="hero__line hero__line--2 text-accent hero__glitch" data-text="TRASFORMA">TRASFORMA</span><br />
        <span class="hero__line hero__line--3">I TUOI OBIETTIVI</span>
      </h1>
      <p class="hero__sub"><span class="hero__sub--white">Non una palestra.</span> <span class="text-accent">Un metodo.</span></p>
      <div class="hero__ctas">
        <div class="cta-glow-wrap">
          <button class="btn-primary hero__cta-primary gp-trigger">
            Inizia Ora — €17
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
        <button class="btn-outline contact-trigger">Contattaci</button>
      </div>
    </div>
    <div class="hero__scroll">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
      </svg>
    </div>
  </section>

  <!-- ─── PHILOSOPHY ────────────────────────────────────────────────────── -->
  <section id="philosophy" class="section">
    <div class="container">
      <div class="philosophy__grid">
        <!-- Titolo — sempre primo su mobile -->
        <div class="philosophy__header reveal reveal-delay-1">
          <p class="section__label">Chi Siamo</p>
          <h2>LIBERTÀ. METODO.<br /><span class="text-accent">RISULTATI A 360<span class="deg">°</span></span></h2>
          <div class="divider anim-divider"></div>
        </div>
        <!-- Immagine — dopo il titolo su mobile -->
        <div class="philosophy__image-col reveal">
          <div class="philosophy__glow">
            <!-- CTA sopra l'immagine — solo mobile -->
            <a href={`${base}about`} class="philosophy__cta-over">
              Chi siamo
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <img src={`${base}images/pt-session.jpg`} alt="Sessione personal training con istruttore palestra Recomp360 Roma Prenestina" class="philosophy__img" />
          </div>
        </div>
        <!-- Testo + CTA — dopo immagine su mobile -->
        <div class="philosophy__body reveal reveal-delay-2">
          <p class="philosophy__text">
            Libertà della sala attrezzi + expertise del personal training studio.
            Un team di specialisti — trainer, nutrizionista, fisioterapista — per seguirti davvero a tutto tondo.
          </p>
          <a href={`${base}about`} class="cta-secondary philosophy__cta-main" style="margin-top:32px">
            Chi siamo
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-card reveal reveal-delay-1">
          <span class="stat-card__value" data-count="360" data-suffix="°">360°</span>
          <span class="stat-card__label">Cura del percorso</span>
        </div>
        <div class="stat-card reveal reveal-delay-2">
          <span class="stat-card__value" data-count="8" data-suffix="+">8+</span>
          <span class="stat-card__label">Discipline</span>
        </div>
        <div class="stat-card reveal reveal-delay-3">
          <span class="stat-card__value" data-count="100" data-suffix="%">100%</span>
          <span class="stat-card__label">Last-gen</span>
        </div>
        <div class="stat-card reveal reveal-delay-4">
          <span class="stat-card__value" data-count="5" data-suffix="★">5★</span>
          <span class="stat-card__label">Media clienti</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── MYRECOMP ──────────────────────────────────────────────────────── -->
  <section id="myrecomp" class="section section--alt">
    <div class="container">
      <div class="method-header reveal">
        <div>
          <p class="section__label">Il Metodo Proprietario</p>
          <h2>MY<span class="text-accent">RECOMP</span></h2>
          <div class="divider anim-divider"></div>
          <p class="method-header__desc" style="margin-top:16px;font-size:18px;color:var(--white)">Ricomposizione corporea strutturata. Valutazione tecnica, percorso progressivo, risultati misurabili.</p>
        </div>
        <a href={`${base}metodo`} class="cta-secondary method-header__cta">
          Scopri il Metodo
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <!-- Featured card orizzontale con neon border -->
      <div class="method-featured-wrap cta-glow-wrap reveal reveal-delay-1">
        <div class="method-card method-card--featured">
          <div class="method-card__img-wrap">
            <!-- CTA sopra l'immagine — visibile solo mobile -->
            <a href={`${base}metodo`} class="method-card__cta-overlay">
              Scopri il Metodo
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <img src={`${base}images/myrecomp.jpg`} alt="Personal training one-to-one palestra Recomp360 Roma Est" class="method-card__img" loading="lazy" />
          </div>
          <div class="method-card__body">
            <h3>Personal Training</h3>
            <!-- Testo descrittivo — visibile solo mobile (sul desktop è in method-header) -->
            <p class="method-card__desc-mobile">Ricomposizione corporea strutturata. Valutazione tecnica, percorso progressivo, risultati misurabili.</p>
            <p>Il fulcro del metodo MyRecomp. Sessioni 1:1 con un trainer dedicato che costruisce il tuo programma su misura — scheda personalizzata, monitoraggio progressi e supporto nutrizionale integrato.</p>
          </div>
        </div>
      </div>
      <!-- Due card affiancate -->
      <div class="method-grid-small">
        <div class="method-card tilt-card reveal reveal-delay-2">
          <div class="method-card__img-wrap">
            <img src={`${base}images/myrecomp (1).jpg`} alt="Small group training allenamento in piccoli gruppi Recomp360 Roma" class="method-card__img method-card__img--small" loading="lazy" />
          </div>
          <div class="method-card__body">
            <h3>Small Group</h3>
            <p>Massimo 6 persone per sessione. L'attenzione del personal trainer con l'energia del gruppo, orari flessibili e lavoro tecnico e metabolico.</p>
          </div>
        </div>
        <div class="method-card tilt-card reveal reveal-delay-3">
          <div class="method-card__img-wrap">
            <img src={`${base}images/myrecomp (2).jpg`} alt="Sala pesi e gym floor libero palestra Recomp360 Via Prenestina Roma" class="method-card__img method-card__img--small" loading="lazy" />
          </div>
          <div class="method-card__body">
            <h3>Gym Floor</h3>
            <p>Accesso libero con attrezzatura last-generation. Zone dedicate al functional training e al metabolico, staff qualificato sempre presente in sala.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CLASSES ───────────────────────────────────────────────────────── -->
  <section id="classes" class="section">
    <div class="container">
      <!-- Intro: immagine sx, label+heading+testo+bottone dx -->
      <div class="classes-intro reveal">
        <!-- Titolo — sempre primo su mobile -->
        <div class="classes-intro__header">
          <p class="section__label">Attività di Gruppo</p>
          <h2>CORSI <span class="text-accent">FITNESS</span></h2>
          <div class="divider anim-divider"></div>
        </div>
        <!-- Immagine — dopo il titolo su mobile -->
        <div class="classes-intro__glow">
          <!-- CTA sopra l'immagine — solo mobile -->
          <a href={`${base}corsi`} class="classes-intro__cta-over">
            Vedi tutti i corsi
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <div class="classes-intro__img-wrap">
            <img src={`${base}images/fitness recomp.jpg`} alt="Corsi fitness Recomp360" class="classes-intro__img" loading="lazy" />
          </div>
        </div>
        <!-- Descrizione + CTA desktop -->
        <div class="classes-intro__body">
          <p class="classes-intro__desc">8 discipline di gruppo per allenarti con continuità e varietà. Dal Cross Cardio al Pilates, dall'Interval Training alla Zumba — ogni corso è guidato da trainer specializzati e pensato per migliorare resistenza, forza e benessere a tutto tondo. Orari diversificati, gruppi a numero limitato.</p>
          <a href={`${base}corsi`} class="cta-secondary classes-intro__cta-main" style="margin-top:32px">
            Vedi tutti i corsi
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <div class="carousel-outer reveal">
        <div class="carousel-viewport" id="cls-viewport">
          <div class="carousel-track" id="cls-track">
            {classes.map((c) => (
              <div class="carousel-slide">
                <a href={`${base}corsi`} class="class-card">
                  <div class="class-card__icon" set:html={c.icon} />
                  <h4 class="class-card__name">{c.name}</h4>
                  <p class="class-card__desc">{c.desc}</p>
                  <span class="class-card__cta">Scopri →</span>
                </a>
              </div>
            ))}
          </div>
        </div>
        <div class="carousel-controls">
          <button class="carousel-arrow carousel-arrow--prev" id="cls-prev" aria-label="Precedente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="carousel-dots" id="cls-dots"></div>
          <button class="carousel-arrow carousel-arrow--next" id="cls-next" aria-label="Successiva">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── GYM ───────────────────────────────────────────────────────────── -->
  <section id="gym" class="section section--alt">
    <div class="container">
      <div class="gym__header reveal">
        <div class="gym__title-col">
          <p class="section__label">Sala Attrezzi</p>
          <h2>ATTREZZATURA<br /><span class="text-accent">LAST-GEN</span></h2>
          <div class="divider anim-divider"></div>
        </div>
        <ul class="gym-features">
          <li><span class="check-icon">✓</span> Macchinari di ultima generazione</li>
          <li><span class="check-icon">✓</span> Zone dedicate functional + metabolico</li>
          <li><span class="check-icon">✓</span> Ambiente pulito, curato, moderno</li>
          <li><span class="check-icon">✓</span> Staff qualificato sempre presente</li>
        </ul>
      </div>
      <!-- 3D Spatial carousel -->
      <div class="gym3d reveal reveal-delay-2">
        <div class="gym3d__viewport">
          <div class="gym3d__stage" id="gym3d-stage">
            {gymPhotos.map((p) => (
              <div class="gym3d__card">
                <img src={`${base}images/${p.src}`} alt={p.alt} class="gym3d__img" loading="lazy" />
                <div class="gym3d__shine"></div>
              </div>
            ))}
          </div>
        </div>
        <div class="gym3d__controls">
          <button class="gym3d__arrow" id="gym3d-prev" aria-label="Precedente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="gym3d__dots" id="gym3d-dots"></div>
          <button class="gym3d__arrow" id="gym3d-next" aria-label="Successiva">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── REVIEWS ──────────────────────────────────────────────────────── -->
  <section id="reviews" class="section section--alt">
    <div class="container">
      <!-- Intro: immagine sx, header dx -->
      <div class="reviews-intro reveal">
        <div class="reviews-intro__img-wrap">
          <img src={`${base}images/recensioni.jpg`} alt="Clienti Recomp360" class="reviews-intro__img" loading="lazy" />
        </div>
        <div class="reviews-intro__text">
          <p class="section__label">Recensioni</p>
          <h2>COSA DICONO<br /><span class="text-accent">I NOSTRI CLIENTI</span></h2>
          <div class="divider anim-divider"></div>
        </div>
      </div>
      <!-- Card recensioni -->
      <div class="reviews-grid">
        {reviews.map((r, i) => (
          <div class={`review-card reveal reveal-delay-${i + 1} tilt-card`}>
            <div class="review-card__stars">{'★'.repeat(r.stars)}</div>
            <p class="review-card__text">"{r.text}"</p>
            <strong class="review-card__name">{r.name}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── OFFER ─────────────────────────────────────────────────────────── -->
  <section id="offer" class="offer-section">
    <div class="container offer-section__container">
      <div class="offer-section__grid">
        <div class="offer-section__left">
          <p class="section__label offer-section__label">Inizia Adesso</p>
          <h2>PROVA<br /><img src={`${base}images/logo%20bianco%20e%20nero.png`} alt="Recomp360" class="offer-logo" /></h2>
          <div class="divider"></div>
          <p class="offer-section__desc">Valido 14 giorni dall'attivazione.</p>
        </div>
        <div class="offer-section__right">
          <ul class="offer-list">
            <li><span class="check-icon">✓</span> 7 sessioni di allenamento</li>
            <li><span class="check-icon">✓</span> Valutazione tecnica inclusa</li>
            <li><span class="check-icon">✓</span> Accesso a tutte le zone</li>
            <li><span class="check-icon">✓</span> 14 giorni dall'attivazione</li>
          </ul>
          <div class="cta-glow-wrap offer-btn-wrap">
            <button class="btn-primary offer-btn gp-trigger">
              Attiva la Prova — €17
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FOOTER ────────────────────────────────────────────────────────── -->
  <Footer />

  <!-- ─── GUEST PASS MODAL ─────────────────────────────────────────────── -->
  <GuestPassModal />

  <!-- ─── CONTACT MODAL ────────────────────────────────────────────────── -->
  <ContactModal />
</Layout>

<style>
/* ── HERO ──────────────────────────────────────────────────────────────────── */
.hero {
  position: relative;
  height: 100svh;
  height: 100dvh;
  overflow: hidden;
}
.hero__bg { position: absolute; inset: 0; z-index: 0; }
.hero__video {
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
}
.hero-bg-img {
  display: none;
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
}
.hero__overlay {
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.3) 100%);
}

/* Particle canvas sits between bg and content */
#hero-particles {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

.hero__content {
  position: absolute;
  bottom: 80px;
  left: 0;
  right: 0;
  width: 100%;
  max-width: 100%;
  z-index: 2;
  /* Il padding-inline: 10% viene da .container — non serve left offset aggiuntivo */
}
.hero__title {
  color: var(--white);
  font-size: clamp(26px, 3.4vw, 56px);
  line-height: 1.05;
  margin-bottom: 20px;
  overflow: visible;
}
.hero__line {
  display: inline-block;
  white-space: nowrap;
}
.hero__line--1 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.3s both; }
.hero__line--2 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.5s both; }
.hero__line--3 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.7s both; }
.hero__sub {
  font-size: 25px; font-weight: 400;
  color: var(--text-muted);
  margin-bottom: 40px;
  line-height: 1.6;
  white-space: nowrap;
  animation: heroFadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.9s both;
}
.hero__sub--white { color: var(--white); }
.hero__sub .text-accent { font-weight: 700; }
.hero__ctas {
  animation: heroFadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 1.1s both;
}
.hero__scroll {
  position: absolute; bottom: 32px; right: 40px;
  z-index: 2;
  display: flex; align-items: center; justify-content: center;
  animation: heroFadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 1.4s both, scrollBounce 2s ease-in-out 2.5s infinite;
}
@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(6px); }
}

/* TRASFORMA glitch effect */
.hero__glitch {
  position: relative;
  display: inline-block;
  animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.5s both, glitchCycle 6s ease-in-out 2s infinite;
}
.hero__glitch::before,
.hero__glitch::after {
  content: attr(data-text);
  position: absolute;
  inset: 0;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  text-transform: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  pointer-events: none;
  opacity: 0;
}
.hero__glitch::before {
  color: #00f0ff;
  animation: glitchBefore 6s ease-in-out 2s infinite;
}
.hero__glitch::after {
  color: #ff003c;
  animation: glitchAfter 6s ease-in-out 2s infinite;
}

@keyframes glitchCycle {
  0%,88%,100%  { transform: none; }
  89%          { transform: skewX(-3deg); }
  90%          { transform: skewX(0deg); }
  92%          { transform: skewX(2deg); }
  93%          { transform: none; }
}
@keyframes glitchBefore {
  0%,88%,100%  { opacity:0; transform:none; clip-path:none; }
  89%          { opacity:0.7; transform:translate(-3px,0); clip-path:polygon(0 20%,100% 20%,100% 40%,0 40%); }
  90%          { opacity:0; }
  91%          { opacity:0.5; transform:translate(3px,0); clip-path:polygon(0 60%,100% 60%,100% 80%,0 80%); }
  92%          { opacity:0; }
}
@keyframes glitchAfter {
  0%,88%,100%  { opacity:0; transform:none; clip-path:none; }
  90%          { opacity:0.6; transform:translate(3px,-2px); clip-path:polygon(0 50%,100% 50%,100% 70%,0 70%); }
  91%          { opacity:0; }
  93%          { opacity:0.5; transform:translate(-2px,1px); clip-path:polygon(0 10%,100% 10%,100% 30%,0 30%); }
  94%          { opacity:0; }
}

/* Hero entrance */
@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(40px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes scrollPulse { 0%,100%{opacity:.4} 50%{opacity:1} }

/* ── SCROLL REVEAL ─────────────────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(48px);
  transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
              transform 0.8s cubic-bezier(0.16,1,0.3,1);
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}
.reveal-delay-1 { transition-delay: 0.08s; }
.reveal-delay-2 { transition-delay: 0.16s; }
.reveal-delay-3 { transition-delay: 0.24s; }
.reveal-delay-4 { transition-delay: 0.32s; }

/* ── DIVIDER DRAW ──────────────────────────────────────────────────────────── */
.anim-divider {
  width: 0 !important;
  transition: width 1s cubic-bezier(0.16,1,0.3,1) 0.3s !important;
}
.anim-divider.drawn {
  width: 48px !important;
}


/* ── 3D TILT CARDS ─────────────────────────────────────────────────────────── */
.tilt-card {
  transform-style: preserve-3d;
  will-change: transform;
  transition: transform 0.15s ease, border-color 0.3s ease !important;
}
.tilt-card.visible { transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.15s ease, border-color 0.3s ease !important; }

/* ── PHILOSOPHY ────────────────────────────────────────────────────────────── */
.philosophy__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto 1fr;
  grid-template-areas:
    "img header"
    "img body";
  gap: 0 64px;
  margin-bottom: 48px;
}
.philosophy__image-col { grid-area: img; position: relative; }
.philosophy__header    { grid-area: header; align-self: end; }
.philosophy__body      { grid-area: body; align-self: start; padding-top: 24px; }
.philosophy__text {
  margin-top: 0; font-size: 18px;
  color: var(--white); line-height: 1.7;
  max-width: 520px;
}

/* CTA overlay sull'immagine — solo mobile */
.philosophy__cta-over {
  display: none;
  position: absolute;
  bottom: 16px; left: 16px;
  z-index: 3;
  background: var(--accent);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
  text-transform: uppercase; text-decoration: none;
  align-items: center; gap: 8px;
  padding: 8px 14px;
}
.philosophy__cta-over svg { width: 14px; height: 14px; flex-shrink: 0; }

/* Glow wrapper philosophy */
.philosophy__glow {
  position: relative;
  isolation: isolate;
}
.philosophy__glow::before,
.philosophy__glow::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 6px;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent) 40%,
    #ff8080 50%,
    #ffffff 55%,
    var(--accent) 60%,
    transparent 80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.philosophy__glow::after {
  filter: blur(8px) opacity(0.6);
  z-index: -1;
}
.philosophy__img {
  position: relative;
  z-index: 1;
  width: 100%; height: 420px;
  object-fit: cover; object-position: center top;
  border-radius: 4px;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.philosophy__image-col:hover .philosophy__img { transform: scale(1.02); }

/* Stat row */
.stats-row {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px;
}
.stat-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 28px 20px; text-align: center;
  min-width: 0;
  transition: border-color .3s, box-shadow .3s;
}
.stat-card:hover {
  border-color: var(--accent);
  box-shadow: 0 0 24px rgba(229,51,50,0.12);
}
.stat-card__value {
  display: block; font-family: var(--font-head);
  font-size: 44px; color: var(--accent); letter-spacing: 1px; line-height: 1;
  white-space: nowrap;
}
.stat-card__label {
  display: block; font-size: 12px; font-weight: 600;
  letter-spacing: 2px; text-transform: uppercase;
  color: var(--white); margin-top: 8px;
}

/* ── MYRECOMP ──────────────────────────────────────────────────────────────── */
.method-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; margin-bottom: 40px;
}
.method-header__cta { flex-shrink: 0; align-self: flex-end; }

/* Featured card wrapper (neon border via cta-glow-wrap) */
.method-featured-wrap {
  display: block;
  width: 100%;
  margin-bottom: 20px;
}

/* Due card affiancate */
.method-grid-small {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.method-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 4px; overflow: hidden;
  transition: border-color .3s ease, box-shadow .3s ease;
}
.method-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 32px rgba(229,51,50,0.1);
}

/* Featured: orizzontale immagine sx, testo dx */
.method-card--featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-color: var(--accent-dim-40);
  position: relative;
  z-index: 1;
  height: 380px;
}
.method-card--featured .method-card__img-wrap { height: 380px; overflow: hidden; }
.method-card--featured .method-card__body {
  padding: 40px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.method-card__img-wrap { overflow: hidden; }
.method-card__img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
  transition: transform .6s cubic-bezier(0.16,1,0.3,1);
}
.method-card__img--small { height: 260px; }
.method-card:hover .method-card__img { transform: scale(1.06); }

.method-card__body { padding: 24px 28px; }
.method-card__body h3 { margin: 14px 0 8px; font-size: 18px; color: var(--accent); }
.method-card__body p  { font-size: 18px; color: var(--white); line-height: 1.7; }

.badge {
  display: inline-block; font-size: 11px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--accent);
}
.badge--muted { color: var(--text-muted); }

/* ── CLASSES INTRO ─────────────────────────────────────────────────────────── */
.classes-intro {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto 1fr;
  grid-template-areas:
    "img header"
    "img body";
  gap: 0 60px;
  margin-bottom: 64px;
}
.classes-intro__glow   { grid-area: img; }
.classes-intro__header { grid-area: header; align-self: end; }
.classes-intro__body   { grid-area: body; align-self: start; padding-top: 24px; }
/* Glow wrapper — applica bordo neon rotante intorno all'immagine */
.classes-intro__glow {
  position: relative;
  isolation: isolate;
}
.classes-intro__glow::before,
.classes-intro__glow::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 6px;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent) 40%,
    #ff8080 50%,
    #ffffff 55%,
    var(--accent) 60%,
    transparent 80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.classes-intro__glow::after {
  filter: blur(8px) opacity(0.6);
  z-index: -1;
}
.classes-intro__img-wrap {
  position: relative;
  z-index: 1;
  overflow: hidden;
  border-radius: 4px;
}
.classes-intro__img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  object-position: center 30%;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.classes-intro__img-wrap:hover .classes-intro__img { transform: scale(1.04); }
/* CTA overlay sull'immagine — solo mobile */
.classes-intro__cta-over {
  display: none;
  position: absolute;
  bottom: 16px; left: 16px;
  z-index: 3;
  background: var(--accent);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
  text-transform: uppercase; text-decoration: none;
  align-items: center; gap: 8px;
  padding: 8px 14px;
}
.classes-intro__cta-over svg { width: 14px; height: 14px; flex-shrink: 0; }

/* method-card CTA overlay sull'immagine — solo mobile */
.method-card__cta-overlay {
  display: none;
  position: absolute;
  bottom: 16px; left: 16px;
  z-index: 3;
  background: var(--accent);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 12px; font-weight: 700; letter-spacing: 1.5px;
  text-transform: uppercase; text-decoration: none;
  align-items: center; gap: 8px;
  padding: 8px 14px;
}
.method-card__cta-overlay svg { width: 14px; height: 14px; flex-shrink: 0; }
.method-card__img-wrap { position: relative; overflow: hidden; }

/* Descrizione mobile nella featured card — solo mobile */
.method-card__desc-mobile { display: none !important; }

.classes-intro__desc {
  font-size: 18px;
  color: var(--white);
  line-height: 1.8;
  max-width: 520px;
  margin-top: 0;
}

/* ── CLASSES CAROUSEL ──────────────────────────────────────────────────────── */

.carousel-outer {
  position: relative;
}
.carousel-viewport {
  overflow: hidden;
  padding-block: 14px;
}
.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
  position: relative;
  z-index: 7;
}
.carousel-track {
  display: flex; gap: 16px;
  transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  will-change: transform;
}
.carousel-slide {
  flex: 0 0 calc(25% - 12px);
}

.class-card {
  display: flex; flex-direction: column; align-items: flex-start;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 8px; padding: 28px 22px; height: 100%;
  text-decoration: none; color: inherit;
  transition: border-color .25s, transform .25s, box-shadow .25s;
}
.class-card:hover {
  border-color: var(--accent);
  transform: translateY(-4px);
  box-shadow: 0 10px 28px rgba(229,51,50,0.12);
}
.class-card__icon {
  width: 48px; height: 48px;
  background: rgba(229,51,50,0.08); border: 1px solid rgba(229,51,50,0.18);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 18px; color: var(--accent);
  transition: background .25s;
}
.class-card:hover .class-card__icon {
  background: rgba(229,51,50,0.16);
}
.class-card__icon svg { display: block; }
.class-card__name {
  font-size: 18px; font-weight: 700; letter-spacing: 0.4px;
  color: var(--accent); margin-bottom: 10px; line-height: 1.2;
}
.class-card__desc {
  font-size: 18px; color: var(--white); line-height: 1.6;
  flex: 1; margin-bottom: 20px;
}
.class-card__cta {
  font-size: 18px; font-weight: 700; letter-spacing: 1px;
  text-transform: uppercase; color: var(--accent);
  transition: letter-spacing .2s;
}
.class-card:hover .class-card__cta { letter-spacing: 2px; }

/* Arrows */
.carousel-arrow {
  width: 38px; height: 38px; flex-shrink: 0;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 50%; cursor: pointer; color: var(--text-muted);
  display: flex; align-items: center; justify-content: center;
  transition: border-color .2s, color .2s, background .2s;
}
.carousel-arrow:hover { border-color: var(--accent); color: var(--accent); background: rgba(229,51,50,0.06); }
.carousel-arrow:disabled { opacity: .3; pointer-events: none; }

/* Dots */
.carousel-dots {
  display: flex; justify-content: center; gap: 6px;
}
:global(.carousel-dot) {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--border); border: none; cursor: pointer; padding: 0;
  transition: background .25s, transform .25s;
}
:global(.carousel-dot.active) { background: var(--accent); transform: scale(1.4); }

/* ── GYM ───────────────────────────────────────────────────────────────────── */
.gym__header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
  margin-bottom: 88px;
}
.gym__title-col .divider { margin-top: 20px; }
/* lista allineata all'h2: il label è ~36px (font 12px + margin-bottom 16px + line-height) */
.gym-features {
  display: flex; flex-direction: column; gap: 18px;
  padding-top: 40px;
  padding-left: 12%;
}
.gym-features li {
  display: flex; align-items: center; gap: 12px;
  font-size: 18px; color: var(--white); list-style: none;
}
.check-icon { color: var(--accent); font-weight: 700; flex-shrink: 0; }

/* ── GYM 3D SPATIAL CAROUSEL ───────────────────────────────────────────────── */
.gym3d {
  position: relative;
  user-select: none;
}
/* Edge fade — cards emerge from darkness */
.gym3d::before, .gym3d::after {
  content: '';
  position: absolute;
  top: 0; height: 320px;
  width: 100px; z-index: 6; pointer-events: none;
}
.gym3d::before { left: 0;  background: linear-gradient(to right, var(--bg-alt) 0%, transparent 100%); }
.gym3d::after  { right: 0; background: linear-gradient(to left,  var(--bg-alt) 0%, transparent 100%); }

.gym3d__viewport {
  perspective: 1000px;
  height: 320px;
  position: relative;
  overflow: visible;
}
.gym3d__stage {
  position: relative;
  width: 100%; height: 100%;
}
.gym3d__card {
  position: absolute;
  top: 0; left: 0;
  width: 58%; height: 100%;
  border-radius: 16px;
  overflow: hidden;
  cursor: pointer;
  transition:
    transform  0.65s cubic-bezier(0.16,1,0.3,1),
    opacity    0.65s ease,
    box-shadow 0.65s ease;
  will-change: transform, opacity;
}
.gym3d__img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.gym3d__card:hover .gym3d__img { transform: scale(1.04); }
/* Specular shine overlay */
.gym3d__shine {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.09) 0%, transparent 45%);
  pointer-events: none;
  border-radius: inherit;
}
/* Controls row */
.gym3d__controls {
  display: flex; align-items: center; justify-content: center;
  gap: 20px; margin-top: 32px; position: relative; z-index: 7;
}
.gym3d__arrow {
  width: 40px; height: 40px; flex-shrink: 0;
  background: var(--accent); border: 1px solid var(--accent);
  border-radius: 50%; cursor: pointer; color: var(--white);
  display: flex; align-items: center; justify-content: center;
  transition: border-color .2s, color .2s, background .2s;
}
.gym3d__arrow:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
.gym3d__dots { display: flex; gap: 6px; align-items: center; }
:global(.gym3d__dot) {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--border); border: none; cursor: pointer; padding: 0;
  transition: background .25s, transform .25s;
}
:global(.gym3d__dot.active) { background: var(--accent); transform: scale(1.4); }

/* ── OFFER ─────────────────────────────────────────────────────────────────── */
.offer-section { border-top: 1px solid var(--border); overflow: hidden; }
/* Container full-bleed: rimuove padding così le colonne colorano fino ai bordi */
.offer-section__container { padding-inline: 0; max-width: 100%; }
.offer-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 360px;
}
/* Blocco rosso — padding-left in vw per allinearlo al container del resto della pagina */
.offer-section__left {
  background: var(--accent);
  padding: 80px 8% 80px 10vw;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.offer-section__desc { margin-top: auto !important; }
.offer-section__left h2 { color: var(--white); line-height: 1.05; margin-top: 12px; font-size: clamp(22px, 3vw, 38px); }
.offer-section__left .divider { display: none; }
/* Label nel blocco rosso: bianco invece di accent (lo sfondo è già rosso) */
.offer-section__label { color: var(--white) !important; }
.offer-section__desc {
  margin-top: 0;
  font-size: 18px;
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  max-width: 440px;
}
/* Blocco scuro */
.offer-section__right {
  background: var(--bg-card);
  padding: 80px 8%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 36px;
}
.offer-btn-wrap { margin-top: auto; }
/* Lista offerta */
.offer-list { display: flex; flex-direction: column; gap: 16px; }
.offer-list li {
  display: flex; align-items: center; gap: 12px;
  font-size: 18px; color: var(--white); list-style: none;
}
.offer-btn { position: relative; z-index: 1; background: var(--bg); white-space: nowrap; padding: 16px 36px; font-size: 20px; }
.offer-btn:hover { background: var(--accent); }
.offer-btn-wrap { display: inline-block; isolation: isolate; position: relative; }

/* ── REVIEWS ───────────────────────────────────────────────────────────────── */
.reviews-intro {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: start;
  margin-bottom: 64px;
}
.reviews-intro__img-wrap {
  overflow: hidden;
  border-radius: 4px;
}
.reviews-intro__img {
  width: 100%; height: 420px;
  object-fit: cover; object-position: center 20%;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.reviews-intro__img-wrap:hover .reviews-intro__img { transform: scale(1.04); }
.reviews-intro__text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.reviews-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 20px;
}
.review-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: var(--radius-lg); padding: 32px 28px;
  transition: border-color .2s, box-shadow .2s;
}
.review-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 24px rgba(229,51,50,0.08);
}
.review-card__stars { color: var(--accent); font-size: 18px; letter-spacing: 2px; margin-bottom: 16px; }
.review-card__text {
  font-size: 16px; color: var(--white);
  font-style: italic; line-height: 1.7; margin-bottom: 20px;
}
.review-card__name { font-size: 14px; font-weight: 700; color: var(--accent); }

/* ── DEG SYMBOL (Microgramma non ha °) ────────────────────────────────────── */
.deg { font-family: var(--font-body); font-size: 0.85em; vertical-align: super; }

/* ── CTA SECONDARY (ghost rosso → bianco su hover) ────────────────────────── */
.cta-secondary {
  display: inline-flex;
  align-items: center;
