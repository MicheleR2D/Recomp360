---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import GuestPassModal from '../components/GuestPassModal.astro';

const base = import.meta.env.BASE_URL;
const TYPEFORM_URL = 'https://zgcrbhl8m6b.typeform.com/InfoBody';
---

<Layout title="Il Metodo MyRecomp — Recomp360" description="Scopri il metodo MyRecomp: personal training, small group e sala libera per la tua ricomposizione corporea.">
  <Nav />

  <section class="page-hero">
    <div class="page-hero__bg">
      <img
        src={`${base}images/metodo-hero.jpg`}
        alt="Personal training TRX Recomp360"
        class="page-hero__img"
      />
      <div class="page-hero__overlay page-hero__overlay--left"></div>
      <div class="page-hero__overlay page-hero__overlay--bottom"></div>
    </div>
    <div class="page-hero__content">
      <p class="page-hero__label">IL METODO</p>
      <h1>MY<span class="text-accent">RECOMP</span></h1>
      <p class="page-hero__sub">Un programma strutturato con valutazione tecnica, percorso progressivo e monitoraggio costante.</p>
      <div class="hero__ctas">
        <div class="cta-glow-wrap">
          <button class="btn-primary hero__cta-primary gp-trigger">
            Inizia Ora — €17
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
        <button class="btn-outline contact-trigger">Contattaci</button>
      </div>
    </div>
    <div class="page-hero__scroll" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
      </svg>
    </div>
  </section>

  <section id="metodo-detail" class="section">
    <div class="container">

      <div class="detail-inner">

        <div class="detail-section-header reveal">
          <h2>MY<span class="text-accent">RECOMP</span></h2>
          <div class="divider anim-divider"></div>
          <p class="detail-section-desc">Personal training 1:1, small group e sala libera con attrezzatura last-gen: tre livelli di supporto, un unico obiettivo. Valutazione tecnica inclusa, percorso su misura, supporto nutrizionale integrato.</p>
        </div>

        <!-- Featured: Personal Training — orizzontale con neon border -->
        <div class="cta-glow-wrap detail-featured-wrap reveal">
          <div class="detail-card detail-card--featured">
            <div class="detail-card__img-wrap">
              <img src={`${base}images/Metodo recomp 1.jpg`} alt="Personal Training Recomp360" class="detail-card__img" loading="lazy" />
            </div>
            <div class="detail-card__body">
              <span class="badge">Core</span>
              <h3>PERSONAL TRAINING</h3>
              <p>Il fulcro del metodo MyRecomp. Sessioni 1:1 con un trainer dedicato che costruisce il tuo programma su misura — tenendo conto del tuo corpo, dei tuoi obiettivi e del tuo stile di vita.</p>
              <ul class="feature-list">
                <li><span class="check">✓</span> Valutazione tecnica iniziale completa</li>
                <li><span class="check">✓</span> Scheda di allenamento personalizzata</li>
                <li><span class="check">✓</span> Monitoraggio progressi periodico</li>
                <li><span class="check">✓</span> Supporto diretto con il nutrizionista</li>
                <li><span class="check">✓</span> Revisione e aggiornamento scheda nel tempo</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Due card affiancate con thumbnail in cima -->
        <div class="detail-grid-small">
          <div class="detail-card tilt-card reveal reveal-delay-1">
            <div class="detail-card__img-wrap">
              <img src={`${base}images/Metodo recomp 2.jpg`} alt="Small Group Training Recomp360" class="detail-card__img" loading="lazy" />
            </div>
            <div class="detail-card__body">
              <span class="badge badge--muted">Gruppo</span>
              <h3>SMALL GROUP TRAINING</h3>
              <p>L'efficacia del personal training nell'energia di un piccolo gruppo. Massimo 6 persone per sessione, per garantire attenzione individuale senza rinunciare alla motivazione collettiva.</p>
              <ul class="feature-list">
                <li><span class="check">✓</span> Gruppi di massimo 6 persone</li>
                <li><span class="check">✓</span> Lavoro tecnico e metabolico</li>
                <li><span class="check">✓</span> Trainer dedicato per ogni sessione</li>
                <li><span class="check">✓</span> Orari flessibili</li>
              </ul>
            </div>
          </div>
          <div class="detail-card tilt-card reveal reveal-delay-2">
            <div class="detail-card__img-wrap">
              <img src={`${base}images/Metodo recomp 3.jpg`} alt="Sala Attrezzi Recomp360" class="detail-card__img" loading="lazy" />
            </div>
            <div class="detail-card__body">
              <span class="badge badge--muted">Accesso</span>
              <h3>SALA ATTREZZI LIBERA</h3>
              <p>Accesso alla sala con attrezzatura last-generation. Alleni nei tuoi tempi, con la sicurezza di uno staff qualificato sempre presente e zone dedicate per ogni tipo di lavoro.</p>
              <ul class="feature-list">
                <li><span class="check">✓</span> Macchinari last-generation</li>
                <li><span class="check">✓</span> Zona functional training</li>
                <li><span class="check">✓</span> Zona metabolica dedicata</li>
                <li><span class="check">✓</span> Staff sempre presente</li>
              </ul>
            </div>
          </div>
        </div>

      </div><!-- /detail-inner -->
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">

      <!-- Top: immagine sinistra + testo destra -->
      <div class="team-top">
        <div class="team-top__img-wrap">
          <img src={`${base}images/pt recomp.jpeg`} alt="Personal Trainer Recomp360" class="team-top__img" loading="lazy" />
        </div>
        <div class="team-top__text">
          <p class="section__label">Il Team</p>
          <h2 class="team-heading">ESPERTI <span class="text-accent">A 360<span class="deg">°</span></span></h2>
          <div class="divider"></div>
          <p class="team-desc">Il nostro staff è composto da personal trainer certificati specializzati in ricomposizione corporea, affiancati da nutrizionisti, fisioterapisti e osteopati. Un team integrato che lavora insieme per seguirti a 360 gradi — dall'allenamento alla postura, dall'alimentazione alla prevenzione degli infortuni.</p>
        </div>
      </div>

      <!-- 4 card su una riga -->
      <div class="team-cards">
        <div class="team-card">
          <h4>PERSONAL TRAINER</h4>
          <p>Specializzati in ricomposizione corporea e allenamento funzionale.</p>
        </div>
        <div class="team-card">
          <h4>NUTRIZIONISTA</h4>
          <p>Piani alimentari personalizzati integrati con il programma di allenamento.</p>
        </div>
        <div class="team-card">
          <h4>FISIOTERAPIA</h4>
          <p>Prevenzione, recupero infortuni e ottimizzazione del movimento.</p>
        </div>
        <div class="team-card">
          <h4>POSTUROLOGIA &amp; OSTEOPATIA</h4>
          <p>Valutazione posturale completa e trattamenti osteopatici.</p>
        </div>
      </div>

    </div>
  </section>

  <section id="offer" class="offer-section">
    <div class="container offer-section__container">
      <div class="offer-section__grid">
        <div class="offer-section__left">
          <p class="section__label offer-section__label">Inizia Adesso</p>
          <h2>PROVA<br />RECOMP360<br /><span class="text-accent">A €17</span></h2>
          <div class="divider"></div>
          <p class="offer-section__desc">Valido 14 giorni dall'attivazione.</p>
        </div>
        <div class="offer-section__right">
          <ul class="offer-list">
            <li><span class="check-icon">✓</span> 7 sessioni di allenamento</li>
            <li><span class="check-icon">✓</span> Valutazione tecnica inclusa</li>
            <li><span class="check-icon">✓</span> Accesso a tutte le zone</li>
            <li><span class="check-icon">✓</span> 14 giorni dall'attivazione</li>
          </ul>
          <div class="cta-glow-wrap offer-btn-wrap">
            <button class="btn-primary offer-btn gp-trigger">
              Attiva la Prova — €17
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ContactModal />
  <GuestPassModal />
</Layout>

<script>
// ── SCROLL REVEAL + DIVIDER DRAW ────────────────────────────────────────────
(function () {
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      e.target.classList.add('visible');
      if (e.target.classList.contains('anim-divider')) e.target.classList.add('drawn');
      io.unobserve(e.target);
    }
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal, .anim-divider').forEach(el => io.observe(el));
})();

// ── 3D TILT ON CARDS ────────────────────────────────────────────────────────
(function () {
  const MAX = 9;
  document.querySelectorAll('.tilt-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      const y = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      card.style.transform = `perspective(700px) rotateY(${x * MAX}deg) rotateX(${-y * MAX}deg) translateY(-4px)`;
      card.style.transition = 'transform 0.1s ease, border-color 0.3s ease, box-shadow 0.3s ease';
    }, { passive: true });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'transform 0.5s cubic-bezier(0.16,1,0.3,1), border-color 0.3s ease, box-shadow 0.3s ease';
    });
  });
})();
</script>

<style>
.text-accent { color: var(--accent); }

/* Override specifico per l'immagine hero di questa pagina */
.page-hero__img { object-position: center 20%; }

/* ── DETAIL SECTION HEADER ─────────────────────────────────────────────────── */
.detail-section-header { margin-bottom: 48px; }
.detail-section-desc {
  margin-top: 20px;
  font-size: 18px;
  color: var(--white);
  max-width: 640px;
  line-height: 1.7;
}

/* ── NEON BORDER per la featured card ─────────────────────────────────────── */
@property --angle { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
@keyframes borderRotate { to { --angle: 360deg; } }

.detail-featured-wrap {
  display: block;
  width: 100%;
  margin-bottom: 20px;
  position: relative;
  isolation: isolate;
}
.detail-featured-wrap::before,
.detail-featured-wrap::after {
  content: '';
  position: absolute;
  inset: -2px;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent) 40%,
    #ff8080 50%,
    #ffffff 55%,
    var(--accent) 60%,
    transparent 80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.detail-featured-wrap::after {
  filter: blur(8px) opacity(0.6);
  z-index: -1;
}

/* ── CARD BASE ─────────────────────────────────────────────────────────────── */
.detail-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  transition: border-color .3s, box-shadow .3s;
}
.detail-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 32px rgba(229,51,50,0.10);
}

/* ── FEATURED CARD — horizontal ────────────────────────────────────────────── */
.detail-card--featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-color: var(--accent-dim-40);
  position: relative;
  z-index: 1;
  min-height: 420px;
}
.detail-card--featured .detail-card__body {
  padding: 48px 44px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.detail-card--featured .detail-card__img-wrap {
  min-height: 420px;
}

/* ── SMALL CARDS GRID ──────────────────────────────────────────────────────── */
.detail-grid-small {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.detail-grid-small .detail-card__body {
  padding: 28px 32px 36px;
}

/* ── IMAGE WRAP + ZOOM HOVER ───────────────────────────────────────────────── */
.detail-card__img-wrap { overflow: hidden; }
.detail-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.detail-grid-small .detail-card__img { height: 260px; }
.detail-card:hover .detail-card__img { transform: scale(1.06); }

/* ── TILT CARD ─────────────────────────────────────────────────────────────── */
.tilt-card { transform-style: preserve-3d; will-change: transform; }
.tilt-card.visible {
  transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
              transform 0.15s ease,
              border-color 0.3s ease,
              box-shadow 0.3s ease !important;
}

/* ── CARD TYPOGRAPHY ───────────────────────────────────────────────────────── */
.detail-card h3 { margin: 16px 0 14px; color: var(--accent); }
.detail-card p  { font-size: 18px; color: var(--white); line-height: 1.7; margin-bottom: 28px; }

.feature-list { display: flex; flex-direction: column; gap: 12px; }
.feature-list li { display: flex; align-items: center; gap: 10px; font-size: 18px; color: var(--white); }
.check { color: var(--accent); font-weight: 700; }

.badge {
  display: inline-block; font-size: 11px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--accent);
}
.badge--muted { color: var(--text-muted); }

/* ── RESPONSIVE ────────────────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .detail-card--featured { grid-template-columns: 1fr; }
  .detail-card--featured .detail-card__img-wrap { min-height: 280px; }
  .detail-grid-small { grid-template-columns: 1fr; }
}

/* ── TEAM TOP: immagine + testo ────────────────────────────────────────────── */
.team-top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: flex-start;
  margin-bottom: 48px;
}
.team-top__img-wrap { overflow: hidden; border-radius: 4px; }
.team-top__img {
  width: 100%; height: 420px;
  object-fit: cover; object-position: center center;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.team-top__img-wrap:hover .team-top__img { transform: scale(1.04); }

/* Titolo su una riga + paragrafo */
.team-heading { white-space: nowrap; font-size: clamp(24px, 3.2vw, 50px); }
.team-desc {
  margin-top: 24px;
  font-size: 18px;
  color: var(--white);
  max-width: 520px;
  line-height: 1.7;
}

/* Fix simbolo ° (non presente nel font Microgramma) */
.deg { font-family: var(--font-body); font-size: 0.85em; vertical-align: super; }

/* ── TEAM CARDS: 4 su una riga ─────────────────────────────────────────────── */
.team-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.team-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 4px; padding: 28px 24px;
  transition: border-color .2s, box-shadow .2s;
}
.team-card:hover {
  border-color: var(--accent);
  box-shadow: 0 8px 24px rgba(229,51,50,0.08);
}
.team-card h4 { margin-bottom: 12px; color: var(--accent); }
.team-card p  { font-size: 18px; color: var(--white); line-height: 1.6; }

@media (max-width: 1024px) { .team-cards { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 900px)  {
  .team-top { grid-template-columns: 1fr; gap: 32px; }
  .team-top__img { height: 300px; }
}
@media (max-width: 640px)  { .team-cards { grid-template-columns: 1fr; } }

/* ── OFFER ─────────────────────────────────────────────────────────────────── */
.offer-section { border-top: 1px solid var(--border); overflow: hidden; }
.offer-section__container { padding-inline: 0; max-width: 100%; }
.offer-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 360px;
}
.offer-section__left {
  background: var(--accent);
  padding: 80px 8% 80px 10vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.offer-section__left h2 { color: var(--white); line-height: 1.05; margin-top: 12px; }
.offer-section__left .divider { display: none; }
.offer-section__label { color: var(--white) !important; }
.offer-section__desc {
  margin-top: 0;
  font-size: 18px;
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  max-width: 440px;
}
.offer-section__right {
  background: var(--bg-card);
  padding: 80px 8%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 36px;
}
.offer-list { display: flex; flex-direction: column; gap: 16px; }
.offer-list li {
  display: flex; align-items: center; gap: 12px;
  font-size: 18px; color: var(--white); list-style: none;
}
.check-icon { color: var(--accent); font-weight: 700; }
.offer-btn { position: relative; z-index: 1; background: var(--bg); white-space: nowrap; padding: 16px 36px; font-size: 20px; }
.offer-btn:hover { background: var(--accent); }
.offer-btn-wrap { display: inline-block; isolation: isolate; position: relative; }
@media (max-width: 900px) {
  .offer-section__grid { grid-template-columns: 1fr; }
  .offer-section__left,
  .offer-section__right { padding: 60px 24px; }
}

@media (max-width: 1024px) { .detail-grid { grid-template-columns: 1fr; max-width: 560px; } }
@media (max-width: 900px) {
  .team-grid { grid-template-columns: 1fr; gap: 48px; }
  .team-cards { grid-template-columns: 1fr; }
}
</style>
