---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import GuestPassModal from '../components/GuestPassModal.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Chi Siamo — Recomp360" description="Recomp360: la palestra ibrida di Roma zona Prenestina. Un team di esperti per seguirti a 360 gradi.">
  <Nav />

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <div class="page-hero">
    <div class="page-hero__bg">
      <img
        src={`${base}images/chi siamo.jpg`}
        alt="Chi Siamo Recomp360"
        class="page-hero__img"
      />
      <div class="page-hero__overlay page-hero__overlay--bottom"></div>
    </div>
    <div class="page-hero__content">
      <h1>
        <span class="m-line m-line--2">LIBERTÀ. METODO.</span><br />
        <span class="m-line m-line--3 text-accent">RISULTATI A 360<span style="font-family: Arial, sans-serif;">°</span>.</span>
      </h1>
      <p class="page-hero__sub m-sub">
        Roma, zona Prenestina. Un concept ibrido che unisce la libertà della sala attrezzi
        con l'organizzazione e l'expertise di uno studio di personal training.
      </p>
      <div class="hero__ctas m-ctas">
        <div class="cta-glow-wrap">
          <button class="btn-primary hero__cta-primary gp-trigger">
            Inizia Ora — €17
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
        <button class="btn-outline contact-trigger">Contattaci</button>
      </div>
    </div>
  </div>

  <!-- ─── NON SEI UN NUMERO ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="about-grid">
        <!-- Titolo — sempre primo su mobile -->
        <div class="about-header reveal reveal-delay-1">
          <p class="section__label">La Nostra Filosofia</p>
          <h2>NON SEI<br />UN <span class="text-accent">NUMERO</span></h2>
          <div class="divider anim-divider"></div>
        </div>
        <!-- Immagine — dopo il titolo su mobile -->
        <div class="about-img-glow reveal">
          <img
            src={`${base}images/chi siamo 2.jpg`}
            alt="Recomp360 — Non sei un numero"
            class="about-img"
          />
        </div>
        <!-- Testo — dopo l'immagine su mobile -->
        <div class="about-body reveal reveal-delay-2">
          <p>
            Recomp360 nasce dall'idea che ogni persona meriti un percorso costruito su misura.
            Non basta aprire le porte di una palestra: serve un metodo, un team, una visione.
          </p>
          <p style="margin-top:16px">
            Il nostro approccio è olistico. Trainer specializzati, nutrizionista, fisioterapista,
            posturologa e osteopata lavorano in sinergia per guidarti verso i tuoi obiettivi
            in modo sicuro, progressivo e duraturo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── IL TEAM ───────────────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">

      <!-- RIGA SUPERIORE: immagine sx / titolo+testo dx — con layout mobile title→img→text -->
      <div class="team-intro-row reveal">
        <!-- Titolo — sempre primo su mobile -->
        <div class="team-intro-header">
          <p class="section__label">Il Team</p>
          <h2>PROFESSIONISTI<br /><span class="text-accent">SPECIALIZZATI</span></h2>
          <div class="divider anim-divider"></div>
        </div>
        <!-- Immagine — dopo il titolo su mobile -->
        <div class="team-img-glow">
          <img
            src={`${base}images/chi siamo 3.jpg`}
            alt="Il team Recomp360"
            class="team-img"
          />
        </div>
        <!-- Testo — dopo l'immagine su mobile -->
        <div class="team-intro-body">
          <p class="team-intro__desc">
            Ogni figura lavora in sinergia con le altre: dal personal trainer alla nutrizionista,
            dal fisioterapista alla posturologa. Un team integrato che copre ogni aspetto
            del tuo percorso — allenamento, alimentazione, movimento e recupero.
          </p>
        </div>
      </div>

      <!-- GRIGLIA CARD: 4 box a tutta larghezza -->
      <div class="team-grid">
        <div class="team-card reveal reveal-delay-1">
          <div class="team-card__avatar">
            <!-- Dumbbell — Personal Trainer -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
              <rect x="2" y="10" width="3" height="4" rx="1"/>
              <rect x="19" y="10" width="3" height="4" rx="1"/>
              <rect x="4" y="8" width="3" height="8" rx="1"/>
              <rect x="17" y="8" width="3" height="8" rx="1"/>
              <line x1="7" y1="12" x2="17" y2="12"/>
            </svg>
          </div>
          <h4>PERSONAL TRAINER</h4>
          <p>Specializzati in ricomposizione corporea, allenamento funzionale e strength training.</p>
        </div>
        <div class="team-card reveal reveal-delay-2">
          <div class="team-card__avatar">
            <!-- Apple — Nutrizionista -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
              <path d="M12 21C8 21 4 17.5 4 13c0-4.5 3-8 6-9 1 .5 1.5 1.5 2 1.5s1-.5 2-1.5c3 1 6 4.5 6 9 0 4.5-4 8-8 8z"/>
              <path d="M12 4V2"/>
              <path d="M10 2c1 0 2 .5 2 2"/>
            </svg>
          </div>
          <h4>NUTRIZIONISTA</h4>
          <p>Piani alimentari personalizzati integrati con il tuo programma di allenamento.</p>
        </div>
        <div class="team-card reveal reveal-delay-3">
          <div class="team-card__avatar">
            <!-- Activity / ECG — Fisioterapista -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h4>FISIOTERAPISTA</h4>
          <p>Prevenzione e recupero dagli infortuni. Ottimizzazione del pattern motorio.</p>
        </div>
        <div class="team-card reveal reveal-delay-4">
          <div class="team-card__avatar">
            <!-- Silhouette eretta con linea vertebrale — Posturologa -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
              <circle cx="12" cy="4" r="2"/>
              <line x1="12" y1="2" x2="12" y2="22" stroke-dasharray="2 3" opacity="0.4"/>
              <path d="M12 6v6"/>
              <path d="M9 9h6"/>
              <path d="M10 22l2-7 2 7"/>
              <path d="M9 15c-2 .5-3.5.5-4.5 0"/>
              <path d="M15 15c2 .5 3.5.5 4.5 0"/>
            </svg>
          </div>
          <h4>POSTUROLOGA & OSTEOPATA</h4>
          <p>Valutazione posturale completa e trattamenti per migliorare il movimento quotidiano.</p>
        </div>
      </div><!-- /team-grid -->

    </div>
  </section>

  <!-- ─── VALORI ────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="values-grid">
        <div class="value-block reveal reveal-delay-1">
          <div class="value-block__bg" style={`background-image: url('${base}images/metodo 01.jpg')`}></div>
          <div class="value-block__overlay"></div>
          <div class="value-block__content">
            <h3><span class="text-accent">01</span><br />METODO</h3>
            <p>Un programma strutturato, non improvvisato. Ogni percorso parte da una valutazione tecnica e si evolve nel tempo.</p>
          </div>
        </div>
        <div class="value-block reveal reveal-delay-2">
          <div class="value-block__bg" style={`background-image: url('${base}images/team 02.jpg')`}></div>
          <div class="value-block__overlay"></div>
          <div class="value-block__content">
            <h3><span class="text-accent">02</span><br />TEAM</h3>
            <p>Un gruppo di specialisti che lavorano insieme. Non singoli professionisti isolati, ma una squadra integrata.</p>
          </div>
        </div>
        <div class="value-block reveal reveal-delay-3">
          <div class="value-block__bg" style={`background-image: url('${base}images/risulati 03.jpg')`}></div>
          <div class="value-block__overlay"></div>
          <div class="value-block__content">
            <h3><span class="text-accent">03</span><br />RISULTATI</h3>
            <p>Obiettivi misurabili, progressi monitorati. Perché il tuo tempo e la tua energia valgono risultati concreti.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── OFFER ─────────────────────────────────────────────────────── -->
  <section id="offer" class="offer-section">
    <div class="container offer-section__container">
      <div class="offer-section__grid">
        <div class="offer-section__left">
          <p class="section__label offer-section__label">Inizia Adesso</p>
          <h2>PROVA<br />RECOMP360<span class="deg">°</span><br /><span class="text-accent">A €17</span></h2>
          <div class="divider"></div>
          <p class="offer-section__desc">Valido 14 giorni dall'attivazione.</p>
        </div>
        <div class="offer-section__right">
          <ul class="offer-list">
            <li><span class="check-icon">✓</span> 7 sessioni di allenamento</li>
            <li><span class="check-icon">✓</span> Valutazione tecnica inclusa</li>
            <li><span class="check-icon">✓</span> Accesso a tutte le zone</li>
            <li><span class="check-icon">✓</span> 14 giorni dall'attivazione</li>
          </ul>
          <div class="cta-glow-wrap offer-btn-wrap">
            <button class="btn-primary offer-btn gp-trigger">
              Attiva la Prova — €17
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ContactModal />
  <GuestPassModal />
</Layout>

<style>
.text-accent { color: var(--accent); }
/* Hero subtitle bianco */
.page-hero__sub { color: var(--white); }

/* ── HERO ENTRANCE ─────────────────────────────────────────────────────────── */
@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(40px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes heroFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.m-line    { display: inline-block; }
.m-line--2 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.5s both; }
.m-line--3 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.7s both; }
.m-sub     { animation: heroFadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.9s both; }
.m-ctas    { animation: heroFadeIn  0.8s ease 1.1s both; }
.page-hero__content h1 {
  font-size: clamp(26px, 3.4vw, 56px);
  line-height: 1.05;
  margin-bottom: 20px;
}

/* ── SCROLL REVEAL ─────────────────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(48px);
  transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
              transform 0.8s cubic-bezier(0.16,1,0.3,1);
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}
.reveal-delay-1 { transition-delay: 0.08s; }
.reveal-delay-2 { transition-delay: 0.16s; }
.reveal-delay-3 { transition-delay: 0.24s; }
.reveal-delay-4 { transition-delay: 0.32s; }

/* ── DIVIDER DRAW ──────────────────────────────────────────────────────────── */
.anim-divider {
  width: 0 !important;
  transition: width 1s cubic-bezier(0.16,1,0.3,1) 0.3s !important;
}
.anim-divider.drawn {
  width: 48px !important;
}

/* ── ABOUT GRID ────────────────────────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto 1fr;
  grid-template-areas:
    "img header"
    "img body";
  gap: 0 80px;
}
.about-img-glow { grid-area: img; }
.about-header   { grid-area: header; align-self: end; }
.about-body     { grid-area: body; align-self: start; padding-top: 24px; }
.about-body p { font-size: 18px; color: var(--white); line-height: 1.7; max-width: 480px; }

/* ── IMMAGINE CON GLOW (come philosophy__glow in homepage) ─────────────────── */
.about-img-glow {
  position: relative;
  isolation: isolate;
}
.about-img-glow::before,
.about-img-glow::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 6px;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent) 40%,
    #ff8080 50%,
    #ffffff 55%,
    var(--accent) 60%,
    transparent 80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.about-img-glow::after {
  filter: blur(8px) opacity(0.6);
  z-index: -1;
}
.about-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 480px;
  object-fit: cover;
  object-position: center center;
  border-radius: 4px;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.about-img-glow:hover .about-img { transform: scale(1.02); }

/* ── TESTO SEZIONE "NON SEI UN NUMERO" ──────────────────────────────────────── */
.about-text p {
  font-size: 18px;
  color: var(--white);
  line-height: 1.7;
  max-width: 480px;
}

/* ── TEAM INTRO ROW (immagine sx / titolo+testo dx — layout mobile title→img→text) ─── */
.team-intro-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto 1fr;
  grid-template-areas:
    "img header"
    "img body";
  gap: 0 64px;
  margin-bottom: 64px;
}
.team-img-glow     { grid-area: img; }
.team-intro-header { grid-area: header; align-self: end; }
.team-intro-body   { grid-area: body; align-self: start; }
.team-intro__desc {
  font-size: 18px;
  color: var(--white);
  line-height: 1.7;
  margin-top: 24px;
  max-width: 520px;
}

/* Glow immagine team — identico a philosophy__glow in homepage */
.team-img-glow {
  position: relative;
  isolation: isolate;
}
.team-img-glow::before,
.team-img-glow::after {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 6px;
  background: conic-gradient(
    from var(--angle),
    transparent 20%,
    var(--accent) 40%,
    #ff8080 50%,
    #ffffff 55%,
    var(--accent) 60%,
    transparent 80%
  );
  animation: borderRotate 3s linear infinite;
  z-index: 0;
}
.team-img-glow::after {
  filter: blur(8px) opacity(0.6);
  z-index: -1;
}
.team-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 360px;
  object-fit: cover;
  object-position: center;
  border-radius: 4px;
  display: block;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.team-img-glow:hover .team-img { transform: scale(1.02); }
.team-intro__text {
  font-size: 18px;
  color: var(--white);
  line-height: 1.7;
  margin-top: 20px;
  max-width: 440px;
}

/* ── TEAM GRID 4 colonne a tutta larghezza ─────────────────────────────────── */
.team-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.team-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 32px 24px;
  text-align: center;
  transition: border-color .2s;
}
.team-card:hover { border-color: var(--accent); }
.team-card__avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--accent-dim);
  border: 2px solid var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  margin: 0 auto 24px;
  transition: background 0.2s;
}
.team-card:hover .team-card__avatar {
  background: rgba(229,51,50,0.18);
}
.team-card h4 { margin-bottom: 10px; }
.team-card p {
  font-size: 17px;
  color: var(--white);
  line-height: 1.6;
  max-width: none;
}

/* ── VALORI CON SFONDO IMMAGINE ────────────────────────────────────────────── */
.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.value-block {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  padding: 52px 36px;
  border: 1px solid var(--border);
  transition: border-color 0.3s;
  min-height: 320px;
  display: flex;
  align-items: flex-end;
}
.value-block:hover { border-color: var(--accent); }
.value-block__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  z-index: 0;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.value-block:hover .value-block__bg { transform: scale(1.04); }
.value-block__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.55) 60%, rgba(0,0,0,0.3) 100%);
  z-index: 1;
}
.value-block__content {
  position: relative;
  z-index: 2;
}
.value-block__content h3 { line-height: 1.1; margin-bottom: 16px; }
.value-block__content p {
  font-size: 17px;
  color: var(--white);
  line-height: 1.7;
}

/* ── OFFER ─────────────────────────────────────────────────────────────────── */
.offer-section { border-top: 1px solid var(--border); overflow: hidden; }
.offer-section__container { padding-inline: 0; max-width: 100%; }
.offer-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 360px;
}
.offer-section__left {
  background: var(--accent);
  padding: 80px 8% 80px 10vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.offer-section__left h2 { color: var(--white); line-height: 1.05; margin-top: 12px; }
.offer-section__left .divider { display: none; }
.offer-section__label { color: var(--white) !important; }
.offer-section__desc {
  margin-top: 0;
  font-size: 18px;
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  max-width: 440px;
}
.offer-section__right {
  background: var(--bg-card);
  padding: 80px 8%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 36px;
}
.offer-list { display: flex; flex-direction: column; gap: 16px; }
.offer-list li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 18px;
  color: var(--white);
  list-style: none;
}
.check-icon { color: var(--accent); font-weight: 700; }
.offer-btn {
  position: relative;
  z-index: 1;
  background: var(--bg);
  white-space: nowrap;
  padding: 16px 36px;
  font-size: 20px;
}
.offer-btn:hover { background: var(--accent); }
.offer-btn-wrap { display: inline-block; isolation: isolate; position: relative; }

/* ── RESPONSIVE ────────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .team-intro-row {
    grid-template-columns: 1fr;
    grid-template-areas: "header" "img" "body";
    gap: 24px;
    margin-bottom: 40px;
  }
  .team-intro-header { align-self: auto; }
  .team-intro-body   { padding-top: 0; }
  .team-img          { height: 300px; }
  .team-grid         { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
  .about-grid {
    grid-template-columns: 1fr;
    grid-template-areas: "header" "img" "body";
    gap: 24px;
  }
  .about-header  { align-self: auto; }
  .about-body    { padding-top: 0; }
  .about-img     { height: 320px; }
  .values-grid   { grid-template-columns: 1fr; gap: 20px; }
  .value-block   { min-height: 260px; }
  .offer-section__grid { grid-template-columns: 1fr; }
  .offer-section__left,
  .offer-section__right { padding: 60px 24px; }
}
@media (max-width: 560px) {
  .team-grid { grid-template-columns: 1fr; }
}
</style>

<script>
// ── SCROLL REVEAL + DIVIDER DRAW ────────────────────────────────────────────
(function () {
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      e.target.classList.add('visible');
      if (e.target.classList.contains('anim-divider')) e.target.classList.add('drawn');
      io.unobserve(e.target);
    }
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal, .anim-divider').forEach(el => io.observe(el));
})();
</script>
