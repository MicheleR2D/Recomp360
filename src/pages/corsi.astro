---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import GuestPassModal from '../components/GuestPassModal.astro';

const base = import.meta.env.BASE_URL;

const scheduleLabels = ['LUN', 'MAR', 'MER', 'GIO', 'VEN', 'SAB'];

const schedule = [
  {
    time: '9:00',
    cells: [
      { name: 'POSTURALE', level: 1 },
      null,
      { name: 'POSTURALE', level: 1 },
      null,
      { name: 'POSTURALE', level: 1 },
      null,
    ],
  },
  {
    time: '10:00',
    cells: [
      { name: 'PILATES', level: 1 },
      { name: 'INTERVAL TRAINING', level: 3 },
      { name: 'PILATES', level: 1 },
      { name: 'INTERVAL TRAINING', level: 3 },
      { name: 'PILATES', level: 1 },
      { name: 'FUNZIONALE', level: 3, altTime: '10:10' },
    ],
  },
  {
    time: '11:10',
    cells: [null, null, null, null, null, { name: 'PILATES', level: 1 }],
  },
  {
    time: '13:30',
    cells: [
      null,
      { name: 'CROSS CARDIO', level: 3 },
      null,
      { name: 'CROSS CARDIO', level: 3 },
      null,
      null,
    ],
  },
  {
    time: '18:00',
    cells: [
      { name: 'FUNZIONALE', level: 3 },
      { name: 'PILATES', level: 1 },
      { name: 'FUNZIONALE', level: 3 },
      null,
      { name: 'INTERVAL TRAINING', level: 3 },
      null,
    ],
  },
  {
    time: '19:00',
    cells: [
      null,
      { name: 'FUNZIONALE', level: 2 },
      { name: 'PILATES', level: 1, room: 'Sala Rebalance' },
      { name: 'INTERVAL TRAINING', level: 3 },
      { name: 'PILATES', level: 4, room: 'Sala Rebalance' },
      null,
    ],
  },
  {
    time: '19:10',
    cells: [
      null,
      null,
      { name: 'PREPUGILISTICA', level: 4, room: 'Sala Energy' },
      null,
      { name: 'PREPUGILISTICA', level: 4, room: 'Sala Energy' },
      null,
    ],
  },
  {
    time: '20:00',
    cells: [
      null,
      { name: 'ZUMBA', level: 3 },
      null,
      { name: 'ZUMBA', level: 3 },
      null,
      null,
    ],
  },
  {
    time: '20:10',
    cells: [
      { name: 'METCON', level: 4 },
      null,
      { name: 'METCON', level: 4 },
      null,
      { name: 'METCON', level: 4 },
      null,
    ],
  },
];

const intensityLegend = [
  { level: 1, label: 'Bassa intensità' },
  { level: 2, label: 'Media intensità' },
  { level: 3, label: 'Alta intensità' },
  { level: 4, label: 'Massima intensità' },
];

const classes = [
  {
    name: 'CROSS CARDIO',
    icon: '⚡',
    image: 'cross cardio cover.jpg',
    video: 'Cross Cardio.mp4',
    frame: 1,
    frameEnd: 11,
    desc: 'Allenamento cardiovascolare ad alta intensità con esercizi funzionali. Brucia calorie, migliora la resistenza e il coordinamento.',
    level: 'Tutti i livelli',
    intensity: 3,
  },
  {
    name: 'FUNCTIONAL TRAINING',
    icon: '🏋️',
    image: 'functional training cover.jpg',
    video: 'Functional Training.mp4',
    frame: 3,
    desc: 'Movimenti multi-articolari che replicano i gesti quotidiani. Migliora forza, stabilità e mobilità in modo completo.',
    level: 'Tutti i livelli',
    intensity: 3,
  },
  {
    name: 'INTERVAL TRAINING',
    icon: '🔥',
    image: 'interval training cover.jpg',
    video: 'Interval Training.mp4',
    frame: 1,
    frameEnd: 8,
    desc: 'Alternanza di fasi ad alta intensità e recupero attivo. Massimizza il consumo calorico e la performance cardiovascolare.',
    level: 'Intermedio / Avanzato',
    intensity: 3,
  },
  {
    name: 'MET-CON',
    icon: '💥',
    image: 'metcon cover.jpg',
    video: 'Met-Con.mp4',
    frame: 3,
    desc: 'Metabolic Conditioning: circuiti che combinano forza e cardio per un effetto brucia-grassi prolungato nelle ore successive.',
    level: 'Intermedio / Avanzato',
    intensity: 4,
  },
  {
    name: 'PILATES',
    icon: '🧘',
    image: 'pilates cover.jpg',
    video: 'Pilates.mp4',
    desc: 'Disciplina che rafforza il core, migliora la postura e aumenta la flessibilità attraverso movimenti controllati e precisi.',
    level: 'Tutti i livelli',
    intensity: 1,
  },
  {
    name: 'POSTURAL',
    icon: '⚖️',
    image: 'postural cover.jpg',
    video: 'Posturale.mp4',
    desc: 'Lavoro specifico sulla postura e sulla mobilità articolare. Ideale per chi soffre di dolori o vuole prevenirli.',
    level: 'Tutti i livelli',
    intensity: 1,
  },
  {
    name: 'PRE-BOXING',
    icon: '🥊',
    image: 'boxe cover.jpg',
    video: 'Box.mp4',
    frame: 18,
    desc: 'Tecnica boxe applicata al fitness: coordinazione, velocità e potenza senza contatto. Sfogo totale e divertimento garantito.',
    level: 'Tutti i livelli',
    intensity: 4,
  },
  {
    name: 'ZUMBA',
    icon: '🎵',
    image: 'zumba cover.jpg',
    video: 'Zumba.mp4',
    desc: 'Fitness dance che unisce movimenti di danza latina e internazionale. Efficace, coinvolgente e perfetto per chi odia la palestra classica.',
    level: 'Tutti i livelli',
    intensity: 3,
  },
];

// slot per giorno (usato dalla vista mobile a tab)
const daySlots = scheduleLabels.map((_, dayIdx) =>
  schedule
    .filter(row => row.cells[dayIdx] !== null)
    .map(row => ({ time: row.time, cell: row.cells[dayIdx]! }))
);

// mappa nome-schedula → dati corso (dopo classes per evitare TDZ)
const classLookup: Record<string, typeof classes[0]> = {
  'POSTURALE':         classes.find(c => c.name === 'POSTURAL')!,
  'PILATES':           classes.find(c => c.name === 'PILATES')!,
  'INTERVAL TRAINING': classes.find(c => c.name === 'INTERVAL TRAINING')!,
  'FUNZIONALE':        classes.find(c => c.name === 'FUNCTIONAL TRAINING')!,
  'CROSS CARDIO':      classes.find(c => c.name === 'CROSS CARDIO')!,
  'PREPUGILISTICA':    classes.find(c => c.name === 'PRE-BOXING')!,
  'ZUMBA':             classes.find(c => c.name === 'ZUMBA')!,
  'METCON':            classes.find(c => c.name === 'MET-CON')!,
};
---

<Layout
  title="Corsi Fitness Roma Est | Cross Cardio, Pilates, Funzionale | Recomp360"
  description="8 corsi fitness di gruppo a Roma Est zona Prenestina: Cross Cardio, Functional Training, Interval Training, Met-Con, Pilates, Postural, Pre-Boxing, Zumba. Scopri gli orari."
  image="/images/og/og-corsi.jpg"
  canonical="https://www.recomp360.it/corsi"
>
  <Nav />

  <div class="page-hero">
    <div class="page-hero__bg">
      <img
        src={`${base}images/fitness recomp.jpg`}
        alt="Corsi fitness di gruppo palestra Recomp360 Roma Est zona Prenestina"
        class="page-hero__img"
        style="object-position: 75% center;"
        loading="eager"
        fetchpriority="high"
      />
      <div class="page-hero__overlay page-hero__overlay--left"></div>
    </div>
    <div class="page-hero__content">
      <h1><span class="m-line m-line--2">CORSI </span><span class="m-line m-line--3 text-accent">FITNESS</span></h1>
      <p class="page-hero__sub m-sub">8 discipline per non annoiarti mai.<br>Ogni corso è guidato da istruttori specializzati.</p>
      <div class="hero__ctas m-ctas">
        <div class="cta-glow-wrap">
          <button class="btn-primary hero__cta-primary gp-trigger">
            Inizia Ora — €17
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
        <button class="btn-outline contact-trigger">Contattaci</button>
      </div>
    </div>
  </div>

  <!-- INTRO SECTION -->
  <section class="section intro-section">
    <div class="container intro-section__inner">
      <div>
        <h2 class="intro-section__title">CORSI <span class="text-accent">FITNESS</span></h2>
        <p class="intro-section__text">
          8 discipline progettate per ogni obiettivo, livello e stile di vita.
          Dai corsi ad alta intensità come MET-CON e Interval Training, alle sessioni
          di movimento controllato come Pilates e Posturale — ogni lezione è guidata
          da istruttori specializzati e pensata per darti risultati concreti, settimana
          dopo settimana.
        </p>
      </div>
      <a href="#schedule" class="btn-outline intro-section__cta">
        Vai agli orari
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
      </a>
    </div>
  </section>

  <section class="section classes-section">
    <div class="container">
      <div class="classes-detail-grid">
        {classes.map(c => (
          <div class="class-card">
            <div class="class-card__img">
              {(c as any).video ? (
                <>
                  <video
                    src={`${base}video/${(c as any).video}`}
                    class="class-card__photo card-video"
                    poster={`${base}images/${c.image}`}
                    data-frame={(c as any).frame ? String((c as any).frame) : undefined}
                    data-frame-end={(c as any).frameEnd ? String((c as any).frameEnd) : undefined}
                    muted
                    loop
                    playsinline
                    preload="none"
                  />
                  <button class="media-play-btn" aria-label="Riproduci">
                    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                  </button>
                  <button class="media-fs-btn" aria-label="Schermo intero">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                  </button>
                </>
              ) : (
                <img
                  src={`${base}images/${c.image}`}
                  alt={c.name}
                  class="class-card__photo"
                  loading="lazy"
                />
              )}
            </div>
            <div class="class-card__body">
              <h3 class="class-card__name">{c.name}</h3>
              <div class="class-card__intensity">
                <div class="sch-dots">
                  {[1,2,3,4].map(i => (
                    <span class={`dot ${i <= c.intensity ? 'dot--on' : 'dot--off'}`}></span>
                  ))}
                </div>
                <span class="class-card__intensity-label">
                  {['','Bassa intensità','Media intensità','Alta intensità','Massima intensità'][c.intensity]}
                </span>
              </div>
              <p>{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CALENDAR SECTION -->
  <section id="schedule" class="section schedule-section reveal">
    <div class="container">
      <h2>ORARI <span class="text-accent">CORSI</span></h2>

      <!-- ── Orario: day tabs + frecce (tutti i breakpoint) ─────────────────── -->
      <div class="day-schedule">

        <div class="day-tabs" role="tablist">
          {scheduleLabels.map((label, i) => (
            <button
              class={`day-tab${i === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-day={String(i)}
            >{label}</button>
          ))}
        </div>

        <div class="day-panels">
          {daySlots.map((slots, dayIdx) => (
            <div
              class={`day-panel${dayIdx === 0 ? ' is-active' : ''}`}
              role="tabpanel"
              data-day={String(dayIdx)}
            >
              {slots.length === 0 ? (
                <p class="day-panel__empty">Nessun corso programmato</p>
              ) : (
                slots.map(({ time, cell }) => {
                  const course = classLookup[cell.name];
                  return (
                    <div
                      class="day-slot sch-clickable"
                      data-name={cell.name}
                      data-icon={course?.icon ?? ''}
                      data-intensity={String(course?.intensity ?? 0)}
                      data-desc={course?.desc ?? ''}
                      data-room={cell.room ?? ''}
                      data-image={course?.image ?? ''}
                      data-video={(course as any)?.video ?? ''}
                    >
                      <span class="day-slot__time">{cell.altTime ?? time}</span>
                      <div class="day-slot__body">
                        <span class="day-slot__name">{cell.name}</span>
                        {cell.room && <span class="day-slot__room">{cell.room}</span>}
                      </div>
                      <div class="day-slot__right">
                        <div class="sch-dots">
                          {[1,2,3,4].map(i => (
                            <span class={`dot ${i <= cell.level ? 'dot--on' : 'dot--off'}`}></span>
                          ))}
                        </div>
                        <svg class="day-slot__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="9 18 15 12 9 6"/></svg>
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          ))}
        </div>

        <!-- frecce navigazione giorni -->
        <div class="sch-nav">
          <button class="sch-nav__btn" id="sch-prev" aria-label="Giorno precedente">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <span class="sch-nav__label" id="sch-nav-label">LUN</span>
          <button class="sch-nav__btn" id="sch-next" aria-label="Giorno successivo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

      </div>

      <div class="schedule-legend">
        {intensityLegend.map(({ level, label }) => (
          <div class="legend-item">
            <div class="sch-dots">
              {[1,2,3,4].map(i => (
                <span class={`dot ${i <= level ? 'dot--on' : 'dot--off'}`}></span>
              ))}
            </div>
            <span class="legend-label">{label}</span>
          </div>
        ))}
      </div>

      <p class="schedule-disclaimer">
        Gli istruttori, gli orari e la tipologia di lezione possono variare durante l'anno per garantire la qualità del servizio.
      </p>
    </div>
  </section>

  <section id="offer" class="offer-section">
    <div class="container offer-section__container">
      <div class="offer-section__grid">
        <div class="offer-section__left">
          <p class="section__label offer-section__label">Inizia Adesso</p>
          <h2>PROVA<br /><img src={`${base}images/logo%20bianco%20e%20nero.png`} alt="Recomp360" class="offer-logo" /></h2>
          <div class="divider"></div>
          <p class="offer-section__desc">Valido 14 giorni dall'attivazione.</p>
        </div>
        <div class="offer-section__right">
          <ul class="offer-list">
            <li><span class="check-icon">✓</span> 7 sessioni di allenamento</li>
            <li><span class="check-icon">✓</span> Valutazione tecnica inclusa</li>
            <li><span class="check-icon">✓</span> Accesso a tutte le zone</li>
            <li><span class="check-icon">✓</span> 14 giorni dall'attivazione</li>
          </ul>
          <div class="cta-glow-wrap offer-btn-wrap">
            <button class="btn-primary offer-btn gp-trigger">
              Attiva la Prova — €17
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COURSE MODAL -->
  <div id="course-modal" class="course-modal" role="dialog" aria-modal="true" aria-hidden="true" data-base={base}>
    <div class="course-modal__backdrop"></div>
    <div class="course-modal__card">
      <button class="course-modal__close" aria-label="Chiudi">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="course-modal__img-wrap" id="modal-img-wrap">
        <img id="modal-img" src="" alt="" class="course-modal__img" />
        <video id="modal-video" src="" class="course-modal__img" autoplay muted loop playsinline preload="none" style="display:none;background:#000"></video>
        <button class="media-fs-btn" id="modal-fs-btn" aria-label="Schermo intero" style="display:none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
        </button>
      </div>
      <div class="course-modal__header">
        <div>
          <h3 class="course-modal__name" id="modal-name"></h3>
          <div class="course-modal__intensity">
            <div class="sch-dots" id="modal-dots"></div>
            <span class="course-modal__intensity-label" id="modal-intensity-label"></span>
          </div>
        </div>
      </div>
      <p class="course-modal__desc" id="modal-desc"></p>
      <div class="course-modal__room-wrap" id="modal-room-wrap">
        <span class="course-modal__room-tag">Sala</span>
        <span id="modal-room"></span>
      </div>
    </div>
  </div>

  <Footer />
  <ContactModal />
  <GuestPassModal />
</Layout>

<style>
.text-accent { color: var(--accent); }

/* ── INTRO SECTION ─────────────────────────────────────────────────────────── */
.intro-section {
  padding-bottom: 0;
}
.intro-section__inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 48px;
}
.intro-section__title {
  margin-bottom: 20px;
}
.intro-section__text {
  font-size: 17px;
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  max-width: 680px;
  margin: 0;
}
.intro-section__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  flex-shrink: 0;
  text-decoration: none;
}
@media (max-width: 768px) {
  .intro-section__inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
}

/* ── HERO ENTRANCE ─────────────────────────────────────────────────────────── */
@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(40px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes heroFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.m-line    { display: inline-block; }
.m-line--1 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.3s both; }
.m-line--2 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.5s both; }
.m-line--3 { animation: heroFadeUp 0.9s cubic-bezier(0.16,1,0.3,1) 0.7s both; }
.m-sub     { animation: heroFadeUp 0.8s cubic-bezier(0.16,1,0.3,1) 0.9s both; }
.m-ctas    { animation: heroFadeIn  0.8s ease 1.1s both; }
.page-hero__content h1 { font-size: clamp(26px, 3.4vw, 56px); line-height: 1.05; margin-bottom: 20px; }
.page-hero__sub { color: var(--white); }

.classes-detail-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
}
.class-card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 4px; overflow: hidden;
  display: flex; flex-direction: column;
  transition: border-color .2s;
}
.class-card:hover { border-color: var(--accent); }
.class-card__img {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--bg-alt);
  overflow: hidden;
  border-bottom: 1px solid var(--border);
  position: relative;
}
.class-card__photo {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform .4s ease;
}
video.class-card__photo { background: #000; }

/* Bottone play su video card */
:global(.media-play-btn) {
  position: absolute;
  bottom: 10px;
  left: 10px;
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 4px;
  color: var(--white);
  cursor: pointer;
  transition: background .15s;
  z-index: 2;
}
:global(.media-play-btn:hover) { background: var(--accent); border-color: var(--accent); }

/* Bottone schermo intero su video */
:global(.media-fs-btn) {
  position: absolute;
  bottom: 10px;
  right: 10px;
  width: 32px; height: 32px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 4px;
  color: var(--white);
  cursor: pointer;
  transition: background .15s;
  z-index: 2;
}
:global(.media-fs-btn:hover) { background: var(--accent); border-color: var(--accent); }
.class-card:hover .class-card__photo { transform: scale(1.04); }
.class-card__body { padding: 24px 28px; flex: 1; }
.class-card__name { color: var(--accent); margin: 0 0 8px; }
.class-card__intensity {
  display: flex; align-items: center; gap: 8px; margin-bottom: 16px;
}
.class-card__intensity-label {
  font-size: 11px; font-weight: 600; letter-spacing: 1.5px;
  text-transform: uppercase; color: var(--text-muted);
}
.class-card p { font-size: 17px; color: rgba(255,255,255,0.85); line-height: 1.7; }

.classes-section { padding-bottom: 0; }

/* ── OFFER ─────────────────────────────────────────────────────────────────── */
.offer-section { border-top: 1px solid var(--border); overflow: hidden; }
.offer-section__container { padding-inline: 0; max-width: 100%; }
.offer-section__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 360px;
}
.offer-section__left {
  background: var(--accent);
  padding: 80px 8% 80px 10vw;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.offer-section__desc { margin-top: auto !important; }
.offer-section__left h2 { color: var(--white); line-height: 1.05; margin-top: 12px; font-size: clamp(22px, 3vw, 38px); }
.offer-section__left .divider { display: none; }
.offer-section__label { color: var(--white) !important; }
.offer-section__desc {
  margin-top: 0;
  font-size: 18px;
  color: rgba(255,255,255,0.80);
  line-height: 1.75;
  max-width: 440px;
}
.offer-section__right {
  background: var(--bg-card);
  padding: 80px 8%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 36px;
}
.offer-btn-wrap { margin-top: auto; }
.offer-list { display: flex; flex-direction: column; gap: 16px; }
.offer-list li {
  display: flex; align-items: center; gap: 12px;
  font-size: 18px; color: var(--white); list-style: none;
}
.check-icon { color: var(--accent); font-weight: 700; }
.offer-btn { position: relative; z-index: 1; background: var(--bg); white-space: nowrap; padding: 16px 36px; font-size: 20px; }
.offer-btn:hover { background: var(--accent); }
.offer-btn-wrap { display: inline-block; isolation: isolate; position: relative; }
@media (max-width: 900px) {
  .offer-section__grid { grid-template-columns: 1fr; }
  .offer-section__left,
  .offer-section__right { padding: 60px 24px; }
}

@media (max-width: 768px) { .classes-detail-grid { grid-template-columns: 1fr; } }

/* ── SCHEDULE ─────────────────────────────────────────────────────────────── */
.schedule-section { border-top: 1px solid var(--border); }

.sch-dots {
  display: flex;
  gap: 3px;
  align-items: center;
}
:global(.dot) {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}
:global(.dot--on)  { background: var(--accent); }
:global(.dot--off) { background: rgba(255,255,255,0.12); }

/* Legend */
.schedule-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16px 36px;
  margin-top: 28px;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.legend-label {
  font-size: 11px;
  color: var(--white);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  font-weight: 600;
}

.schedule-disclaimer {
  margin-top: 20px;
  font-size: 13px;
  color: var(--white);
  font-style: italic;
  max-width: 100%;
}

/* Frecce navigazione giorni */
.sch-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  border-top: 1px solid var(--border);
  background: var(--bg-card);
}
.sch-nav__btn {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  transition: background .15s, color .15s, border-color .15s;
  flex-shrink: 0;
}
.sch-nav__btn:hover { background: var(--accent); color: var(--white); border-color: var(--accent); }
.sch-nav__btn:disabled { opacity: 0.25; cursor: default; pointer-events: none; }
.sch-nav__label {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent);
}

/* Hover su celle schedula */
.sch-clickable { cursor: pointer; transition: background .15s; }
.sch-clickable:hover { background: var(--accent-dim) !important; }

/* ── DAY-SCHEDULE (day tabs + frecce, tutti i breakpoint) ─────────────────── */
.day-schedule {
  margin-top: 40px;
  border: 1px solid var(--border);
  border-bottom: 2px solid var(--accent);
  border-right: 2px solid var(--accent);
  border-radius: 4px;
  overflow: hidden;
}

/* Tab row */
.day-tabs {
  display: flex;
  border-bottom: 2px solid var(--accent);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.day-tabs::-webkit-scrollbar { display: none; }

.day-tab {
  flex: 1;
  min-width: 52px;
  padding: 14px 8px;
  background: var(--bg-card);
  border: none;
  border-right: 1px solid var(--border);
  color: var(--text-muted);
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  transition: background .15s, color .15s;
  white-space: nowrap;
}
.day-tab:last-child { border-right: none; }

.day-tab.is-active {
  background: linear-gradient(to bottom, rgba(0,0,0,0.18) 0%, transparent 55%), var(--accent);
  color: var(--white);
  text-shadow: 0 1px 2px rgba(0,0,0,0.5);
}
.day-tab:not(.is-active):hover { background: var(--bg-alt); color: var(--white); }

/* Panels */
.day-panels { background: var(--bg); }

.day-panel { display: none; }
.day-panel.is-active { display: block; }

.day-panel__empty {
  padding: 32px 20px;
  text-align: center;
  font-size: 13px;
  color: var(--text-muted);
  font-style: italic;
}

/* Slot rows */
.day-slot {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--bg-card);
  transition: background .15s;
}
.day-slot:last-child { border-bottom: none; }
.day-slot:hover { background: var(--accent-dim) !important; }

.day-slot__time {
  flex-shrink: 0;
  width: 44px;
  font-size: 12px;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: 0.5px;
}

.day-slot__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.day-slot__name {
  font-size: 13px;
  font-weight: 800;
  color: var(--white);
  letter-spacing: 0.5px;
  text-transform: uppercase;
  line-height: 1.2;
}
.day-slot__room {
  font-size: 10px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.day-slot__right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.day-slot__chevron { color: var(--text-muted); opacity: 0.5; }

/* ── COURSE MODAL ─────────────────────────────────────────────────────────── */
.course-modal {
  position: fixed; inset: 0; z-index: 200;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity .2s;
}
.course-modal.is-open { opacity: 1; pointer-events: auto; }

.course-modal__backdrop {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.75);
}
.course-modal__card {
  position: relative; z-index: 1;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 2px solid var(--accent);
  border-radius: 4px;
  padding: 36px 32px;
  width: min(480px, 90vw);
  transform: translateY(12px);
  transition: transform .2s;
}
.course-modal.is-open .course-modal__card { transform: translateY(0); }

.course-modal__img-wrap {
  margin: -36px -32px 24px;
  height: 180px;
  overflow: hidden;
  border-radius: 4px 4px 0 0;
}
.course-modal__img-wrap.has-video {
  height: auto;
  aspect-ratio: 16 / 9;
}
.course-modal__img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.course-modal__close {
  position: absolute; top: 16px; right: 16px;
  background: none; border: none; cursor: pointer;
  color: var(--text-muted); transition: color .15s;
  padding: 4px;
}
.course-modal__close:hover { color: var(--white); }

.course-modal__header {
  display: flex; align-items: center; gap: 16px; margin-bottom: 20px;
}
.course-modal__icon { font-size: 36px; flex-shrink: 0; }
.course-modal__name {
  color: var(--accent); margin: 0 0 4px; font-size: clamp(16px,1.6vw,22px);
}
.course-modal__intensity {
  display: flex; align-items: center; gap: 8px; margin-top: 4px;
}
.course-modal__intensity-label {
  font-size: 11px; font-weight: 600; letter-spacing: 1.5px;
  text-transform: uppercase; color: var(--text-muted);
}
.course-modal__desc {
  font-size: 15px; color: rgba(255,255,255,0.85);
  line-height: 1.75; margin: 0 0 16px; max-width: 100%;
}
.course-modal__room-wrap {
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 1px;
}
.course-modal__room-tag {
  background: var(--accent-dim); color: var(--accent);
  padding: 2px 8px; border-radius: 2px;
  font-weight: 700; font-size: 10px; letter-spacing: 1.5px;
}
</style>

<script>
const modal           = document.getElementById('course-modal')!;
const BASE            = modal.dataset.base ?? '/';
const backdrop        = modal.querySelector('.course-modal__backdrop')!;
const closeBtn        = modal.querySelector('.course-modal__close')!;
const elName          = document.getElementById('modal-name')!;
const elDots          = document.getElementById('modal-dots')!;
const elIntensityLabel= document.getElementById('modal-intensity-label')!;
const elDesc          = document.getElementById('modal-desc')!;
const elRoom          = document.getElementById('modal-room')!;
const elRoomWrap      = document.getElementById('modal-room-wrap')!;
const elImg           = document.getElementById('modal-img') as HTMLImageElement;
const elVideo         = document.getElementById('modal-video') as HTMLVideoElement;
const elImgWrap       = document.getElementById('modal-img-wrap')!;

const intensityLabels: Record<number, string> = {
  1: 'Bassa intensità',
  2: 'Media intensità',
  3: 'Alta intensità',
  4: 'Massima intensità',
};

function openModal(td: HTMLElement) {
  elName.textContent = td.dataset.name ?? '';
  elDesc.textContent = td.dataset.desc ?? '';

  const vid = td.dataset.video ?? '';
  const img = td.dataset.image ?? '';
  if (vid) {
    elVideo.src = `${BASE}video/${vid}`;
    elVideo.style.display = 'block';
    elImg.style.display = 'none';
    elImgWrap.style.display = 'block';
    elImgWrap.classList.add('has-video');
    modalFsBtn.style.display = 'flex';
  } else if (img) {
    elImg.src = `${BASE}images/${img}`;
    elImg.alt = td.dataset.name ?? '';
    elImg.style.display = 'block';
    elVideo.style.display = 'none';
    elImgWrap.style.display = 'block';
    elImgWrap.classList.remove('has-video');
    modalFsBtn.style.display = 'none';
  } else {
    elImgWrap.style.display = 'none';
    elImgWrap.classList.remove('has-video');
    modalFsBtn.style.display = 'none';
  }

  const lvl = parseInt(td.dataset.intensity ?? '0', 10);
  elDots.innerHTML = [1,2,3,4].map(i =>
    `<span class="dot ${i <= lvl ? 'dot--on' : 'dot--off'}"></span>`
  ).join('');
  elIntensityLabel.textContent = intensityLabels[lvl] ?? '';

  const room = td.dataset.room ?? '';
  elRoom.textContent = room;
  (elRoomWrap as HTMLElement).style.display = room ? 'flex' : 'none';

  modal.setAttribute('aria-hidden', 'false');
  modal.classList.add('is-open');
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  modal.setAttribute('aria-hidden', 'true');
  modal.classList.remove('is-open');
  document.body.style.overflow = '';
  elVideo.pause();
  elVideo.src = '';
}

document.querySelectorAll<HTMLElement>('.sch-clickable').forEach(td => {
  td.addEventListener('click', () => openModal(td));
});

backdrop.addEventListener('click', closeModal);
closeBtn.addEventListener('click', closeModal);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ── Hover play/pause su video card ─────────────────────────────────────────
document.querySelectorAll<HTMLVideoElement>('.card-video').forEach(video => {
  const frame    = video.dataset.frame    ? parseFloat(video.dataset.frame)    : null;
  const frameEnd = video.dataset.frameEnd ? parseFloat(video.dataset.frameEnd) : null;
  const card     = video.closest<HTMLElement>('.class-card__img')!;
  const playBtn  = card.querySelector<HTMLButtonElement>('.media-play-btn')!;
  const iconPlay  = playBtn?.querySelector<SVGElement>('.icon-play')!;
  const iconPause = playBtn?.querySelector<SVGElement>('.icon-pause')!;

  if (frame !== null) {
    video.addEventListener('loadedmetadata', () => { video.currentTime = frame; }, { once: true });
  }

  // loop: usa frameEnd se definito, altrimenti 2s prima della fine naturale
  video.addEventListener('timeupdate', () => {
    const loopBack = frame ?? 0;
    const loopEnd  = frameEnd ?? (video.duration ? video.duration - 2 : null);
    if (loopEnd !== null && video.currentTime >= loopEnd) {
      video.currentTime = loopBack;
    }
  });

  function setPlaying(playing: boolean) {
    iconPlay.style.display  = playing ? 'none' : '';
    iconPause.style.display = playing ? ''     : 'none';
  }

  function stopVideo() {
    video.pause();
    if (frame !== null) { video.currentTime = frame; } else { video.load(); }
    setPlaying(false);
  }

  const isMobile = () => window.matchMedia('(hover: none)').matches;

  // Desktop: hover
  card.addEventListener('mouseenter', () => { if (!isMobile()) { video.play(); setPlaying(true); } });
  card.addEventListener('mouseleave', () => { if (!isMobile()) stopVideo(); });

  // Play button: funziona su desktop e mobile
  playBtn?.addEventListener('click', e => {
    e.stopPropagation();
    if (video.paused) { video.play(); setPlaying(true); }
    else              { stopVideo(); }
  });
});

// ── Fullscreen su video card ────────────────────────────────────────────────
document.querySelectorAll<HTMLButtonElement>('.media-fs-btn').forEach(btn => {
  btn.addEventListener('click', e => {
    e.stopPropagation();
    const video = btn.closest('.class-card__img')?.querySelector<HTMLVideoElement>('.card-video') ?? null;
    if (!video) return;
    if (video.requestFullscreen) video.requestFullscreen();
    else (video as any).webkitRequestFullscreen?.();
  });
});

// Bottone fullscreen modal
const modalFsBtn = document.getElementById('modal-fs-btn') as HTMLButtonElement;
modalFsBtn?.addEventListener('click', () => {
  if (elVideo.requestFullscreen) elVideo.requestFullscreen();
  else (elVideo as any).webkitRequestFullscreen?.();
});

// ── Day tabs + frecce navigazione ──────────────────────────────────────────
const dayTabs    = Array.from(document.querySelectorAll<HTMLElement>('.day-tab'));
const dayPanels  = Array.from(document.querySelectorAll<HTMLElement>('.day-panel'));
const btnPrev    = document.getElementById('sch-prev') as HTMLButtonElement;
const btnNext    = document.getElementById('sch-next') as HTMLButtonElement;
const navLabel   = document.getElementById('sch-nav-label')!;
let currentDay   = 0;

function goToDay(idx: number, scrollTab = true) {
  currentDay = idx;
  const key = String(idx);
  dayTabs.forEach(t => {
    t.classList.toggle('is-active', t.dataset.day === key);
    t.setAttribute('aria-selected', String(t.dataset.day === key));
  });
  dayPanels.forEach(p => {
    p.classList.toggle('is-active', p.dataset.day === key);
  });
  navLabel.textContent = dayTabs[idx]?.textContent ?? '';
  btnPrev.disabled = idx === 0;
  btnNext.disabled = idx === dayTabs.length - 1;

  // scorri il tab attivo in vista (solo su interazione utente, non al caricamento)
  if (scrollTab) {
    dayTabs[idx]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }
}

dayTabs.forEach(tab => {
  tab.addEventListener('click', () => goToDay(Number(tab.dataset.day)));
});

btnPrev.addEventListener('click', () => { if (currentDay > 0) goToDay(currentDay - 1); });
btnNext.addEventListener('click', () => { if (currentDay < dayTabs.length - 1) goToDay(currentDay + 1); });

goToDay(0, false); // inizializza stato senza scrollare
</script>
